  function refreshCheckoutState(){
    var tf=$('timeField'), tt=$('timeText'); if(!tf||!tt)return;
    if(pickupMode==='in_store'){ tt.textContent='ASAP in 5 mins'; tf.setAttribute('disabled','disabled'); }
    else { tf.removeAttribute('disabled'); tt.textContent= scheduled ? scheduled.label : 'ASAP in 15 mins'; }
    // closed note + pay gating
    var s=sched[store&&store.id], note=$('closedNote'), pay=$('payBtn');
