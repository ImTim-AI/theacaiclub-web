  function loadMenu(){
    $('menu').innerHTML='<div class="section"><div class="empty">Loading menu…</div></div>';
    return loadRewards(store.id).then(function(){return api('load-menu',{locationId:store.id});}).then(function(depts){
      depts=depts.filter(function(d){return d&&d.visibleOnline&&Array.isArray(d.menuItems)&&d.menuItems.length;}).sort(function(a,b){return (a.sortOrder||0)-(b.sortOrder||0);});
      CATS=[];MENU={};
