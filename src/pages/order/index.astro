  var PREVIEW=3;
  function grpItems(g){return (g.modifierItems||[]).filter(function(x){return x.active!==false;});}
  // Single-choice when POSCRAFT max==1 (Milk/Coffee Options): show fully, no
  // truncation (you pick exactly one). Multi-select (max==-1, the long Extras/
  // Wellness lists): show 3 + "Show more". Matches JTJ's type-aware rule, with
  // the app's show-3 + bottom-sheet component.
  function isSingleChoice(g){return g && g.max === 1;}
  function optRow(gi,xi,x){
    var pr=(x.salePrice||0)>0?('<div class="op">+'+f(x.salePrice)+'</div>'):'';
    var sel=mSel[gi+'_'+xi]?' sel':'';
    return '<div class="orow'+sel+'" data-g="'+gi+'" data-x="'+xi+'"><div class="ol">'+esc(x.name)+'</div>'+pr+'<div class="mk"></div></div>';
  }
  function renderOpts(){
    if(!mGroups.length){$('mOpts').innerHTML='';updMPrice();return;}
    $('mOpts').innerHTML=mGroups.map(function(g,gi){
      var items=grpItems(g), single=isSingleChoice(g);
      var rows;
      if(single || items.length<=PREVIEW){
        rows=items.map(function(x,xi){return optRow(gi,xi,x);}).join('');
      } else {
        // preview first 3, plus any selected item beyond the preview so a chosen
        // extra never disappears, then a Show more button.
        var shown={};
        rows=items.slice(0,PREVIEW).map(function(x,xi){shown[xi]=1;return optRow(gi,xi,x);}).join('');
        rows+=items.map(function(x,xi){return (!shown[xi]&&mSel[gi+'_'+xi])?optRow(gi,xi,x):'';}).join('');
        rows+='<button class="showmore" data-more="'+gi+'">Show more <span class="sm-arrow">&rarr;</span></button>';
      }
      var req=single?'Choose 1':'Optional';
      return '<div class="opt-grp"><div class="gh"><b>'+esc(g.name)+'</b><span>'+req+'</span></div>'+rows+'</div>';
    }).join('');
    updMPrice();
  }

  // "Show more" bottom-sheet: full list of one group, with prices + a confirm.
  function openMoreSheet(gi){
    var g=mGroups[gi]; if(!g)return;
    $('moreSheet').dataset.g=gi;
    $('msTitle').textContent=g.name.toUpperCase();
