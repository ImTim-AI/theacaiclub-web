        var items=d.menuItems.filter(function(m){return m&&m.isForSale!==false&&!m.deleted;}).map(function(m){
          var ib=RW.bowl.indexOf(+m.departmentId)>=0?1:0,ic=RW.drink.indexOf(+m.departmentId)>=0?1:0;
          return {id:m.id,n:m.name,d:(m.description||'').split('\n')[0],p:m.salePrice||0,img:m.imageUrl,bowl:ib,cup:ic};
