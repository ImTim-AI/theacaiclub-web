<script is:inline>
(function(){
  var SUPA='https://vtrsbxqlctmhkjnpdwdy.supabase.co/functions/v1';
  var ANON='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ0cnNieHFsY3RtaGtqbnBkd2R5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDYyNjIzNzAsImV4cCI6MjA2MTgzODM3MH0.Nn65Q3E2Ly-j8bvn_SaR1TmKYnzcNye1wAiFu5ciiuk';
  var IMG='https://connect.poscraft.co.uk';
  var DRINK=/coffee|smooth|juice|matcha|chai|\btea|chocolate|shot|electrolyte|water|wellness/i;
  var $=function(id){return document.getElementById(id);};
  var f=function(v){return '£'+(v||0).toFixed(2);};
  var esc=function(s){return (s||'').replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});};
  var imgUrl=function(u){return !u?'':(u.indexOf('http')===0?u:IMG+u);};
  function picStyle(u){return u?("background:url('"+u+"') center/cover, var(--off)"):"background:var(--off)";}

  var LOC=[],store=null,sched={},CATS=[],MENU={},activeCat=null,cart=[],modal=null,mGroups=[],mSel={},mq=1;
  var pickupMode='takeaway', scheduled=null; // scheduled = {label, iso} or null (ASAP)
  var tSelDay=0, tSelSlot=null, tSlotsByDay=[];

  function api(fn,body){return fetch(SUPA+'/'+fn,{method:'POST',headers:{'apikey':ANON,'Authorization':'Bearer '+ANON,'Content-Type':'application/json'},body:JSON.stringify(body||{})}).then(function(r){if(!r.ok)throw new Error(fn+' '+r.status);return r.json();});}

  // ---- UK-time helpers (slots generated in Europe/London, fixing the app's device-tz bug) ----
  function ukNow(){ return new Date(new Date().toLocaleString('en-US',{timeZone:'Europe/London'})); }
  function parseClock(s){ // "8AM" / "7:30PM" -> {h,m}
    var m=(s||'').trim().match(/(\d{1,2})(?::(\d{2}))?\s*(AM|PM)/i); if(!m)return null;
    var h=+m[1]%12; if(/pm/i.test(m[3]))h+=12; return {h:h,m:m[2]?+m[2]:0};
  }
  function fmtSlot(d){ var h=d.getHours(),m=d.getMinutes(),ap=h<12?'AM':'PM',hh=h%12;if(hh===0)hh=12;return hh+':'+(m<10?'0'+m:m)+' '+ap; }
  function dayChipLabel(dateStr,idx){ if(idx===0)return 'Today'; if(idx===1)return 'Tomorrow';
    var d=new Date(dateStr+'T00:00:00'); return ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getDay()]; }
  function fmtScheduled(dateStr,d){ // "Mon, 5:30 PM" (app format EEE, h:mm a)
    var wd=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][new Date(dateStr+'T00:00:00').getDay()];
    return wd+', '+fmtSlot(d); }

  function toast(msg){ var t=$('toast'); t.textContent=msg; t.className='toast show'; setTimeout(function(){t.className='toast';},3000); }
  var _confirmCb=null;
  function confirmDialog(title,body,cb){ $('cTitle').textContent=title; $('cBody').textContent=body; _confirmCb=cb; $('confirmDlg').classList.add('open'); }
  function closeConfirm(){ $('confirmDlg').classList.remove('open'); _confirmCb=null; }
  function shortName(n){return (n||'').replace(/^The Acai Club\s*-\s*/i,'');}
  function emoji(n){n=(n||'').toLowerCase();if(n.indexOf('bowl')>=0)return'🍇';if(n.indexOf('coffee')>=0)return'☕';if(n.indexOf('smooth')>=0||n.indexOf('juice')>=0)return'🥤';if(n.indexOf('matcha')>=0||n.indexOf('tea')>=0||n.indexOf('chai')>=0)return'🍵';if(n.indexOf('oat')>=0||n.indexOf('yog')>=0||n.indexOf('banana')>=0)return'🥣';if(n.indexOf('choc')>=0)return'🍫';if(n.indexOf('water')>=0||n.indexOf('electrolyte')>=0)return'💧';if(n.indexOf('pooch')>=0)return'🐶';return'✨';}

  function renderCats(){
    $('catRow').innerHTML=CATS.map(function(c){
      var thumb=c.img?('<span class="pthumb" style="background-image:url(\''+c.img+'\')"></span>'):('<span>'+c.e+'</span>');
      return '<button class="pill '+(c.id===activeCat?'active':'')+'" data-cat="'+c.id+'">'+thumb+esc(c.name)+'</button>';
    }).join('');
  }
  function renderMenu(){
    var cat=CATS.filter(function(c){return c.id===activeCat;})[0];if(!cat)return;
    var items=MENU[activeCat]||[],feat=CATS[0]&&activeCat===CATS[0].id;
    $('menu').innerHTML='<div class="'+(feat?'feat':'section')+'"><h2>'+esc(cat.name)+'</h2><div class="cards">'+items.map(card).join('')+'</div></div>';
  }
  function card(it,i){
    return '<div class="item" data-i="'+i+'"><div class="pic" style="'+picStyle(imgUrl(it.img))+'"></div><div class="body"><div class="nm">'+esc(it.n)+'</div><div class="desc">'+esc(it.d)+'</div><div class="foot"><span class="price">'+f(it.p)+'</span><span class="add">›</span></div></div></div>';
  }

  function loadMenu(){
    $('menu').innerHTML='<div class="section"><div class="empty">Loading menu…</div></div>';
    return api('load-menu',{locationId:store.id}).then(function(depts){
      depts=depts.filter(function(d){return d&&d.visibleOnline&&Array.isArray(d.menuItems)&&d.menuItems.length;}).sort(function(a,b){return (a.sortOrder||0)-(b.sortOrder||0);});
      CATS=[];MENU={};
      depts.forEach(function(d){
        var bowl=/bowl/i.test(d.name)?1:0,cup=DRINK.test(d.name)?1:0;
        var items=d.menuItems.filter(function(m){return m&&m.isForSale!==false&&!m.deleted;}).map(function(m){
          return {id:m.id,n:m.name,d:(m.description||'').split('\n')[0],p:m.salePrice||0,img:m.imageUrl,bowl:bowl,cup:cup};
        });
        if(!items.length)return;
        CATS.push({id:String(d.id),name:d.name,e:emoji(d.name),img:imgUrl(items[0].img)});
        MENU[String(d.id)]=items;
      });
      activeCat=CATS.length?CATS[0].id:null;
      renderCats();
      if(activeCat)renderMenu();else $('menu').innerHTML='<div class="section"><div class="empty">No items available for this store.</div></div>';
    }).catch(function(err){$('menu').innerHTML='<div class="section"><div class="empty">Could not load the live menu ('+esc(err.message)+'). Try refreshing.</div></div>';});
  }

  function applySchedule(s){
    var open=s&&s.isAcceptingOrders, hrs=(s&&s.todayOpeningHours)||'';
    var st=$('openState');st.textContent=open?'Store is open':'Closed';st.className='open'+(open?' is-open':'');
    $('openHours').textContent=hrs;
    document.querySelectorAll('[data-costatus]').forEach(function(el){el.textContent=(open?'Open':'Closed')+(hrs?(' · '+hrs):'');el.className='open'+(open?' is-open':'');});
    refreshCheckoutState();
  }
  function loadSchedule(){
    if(sched[store.id]){applySchedule(sched[store.id]);return Promise.resolve();}
    return api('get-ordering-schedule',{locationId:store.id}).then(function(s){sched[store.id]=s;applySchedule(s);}).catch(function(){});
  }

  // ---- order mode + pickup time + closed gating (parity with app) ----
  function isAccepting(){ var s=sched[store&&store.id]; return !!(s&&s.isAcceptingOrders); }
  function canOrder(){ return isAccepting() || !!scheduled; }
  function setMode(mode){
    pickupMode=mode;
    document.querySelectorAll('[data-mode]').forEach(function(b){b.classList.toggle('sel',b.dataset.mode===mode);});
    if(mode==='in_store') scheduled=null; // in store is always ASAP (5 mins), like the app
    refreshCheckoutState();
  }
  function refreshCheckoutState(){
    var tf=$('timeField'), tt=$('timeText'); if(!tf||!tt)return;
    if(pickupMode==='in_store'){ tt.textContent='ASAP in 5 mins'; tf.setAttribute('disabled','disabled'); }
    else { tf.removeAttribute('disabled'); tt.textContent= scheduled ? scheduled.label : 'ASAP in 15 mins'; }
    // closed note + pay gating
    var s=sched[store&&store.id], note=$('closedNote'), pay=$('payBtn');
    var ok=canOrder();
    if(note){
      if(!isAccepting() && !scheduled){
        var mins=s&&s.timeUntilOrdersAccepted;
        note.textContent= mins!=null ? ('Pick a later time to pre-order, opens in '+mins+' mins') : 'Store is closed. Pick a later time to pre-order.';
        note.className='closednote show';
      } else { note.className='closednote'; }
    }
    if(pay){ pay.className='cta'+(ok?'':' disabled'); pay.disabled=!ok; }
  }

  // ---- pickup-time picker (slots in Europe/London) ----
  function buildSlots(){
    tSlotsByDay=[];
    var s=sched[store&&store.id]; if(!s||!Array.isArray(s.days))return;
    var now=ukNow();
    s.days.forEach(function(day,idx){
      var hrs=(day.openingHours||'').split('-'); var slots=[];
      if(hrs.length===2){
        var o=parseClock(hrs[0]), c=parseClock(hrs[1]);
        if(o&&c){
          var base=new Date(day.date+'T00:00:00');
          var open=new Date(base); open.setHours(o.h,o.m,0,0);
          var close=new Date(base); close.setHours(c.h,c.m,0,0);
          var start=open;
          if(idx===0){ var earliest=new Date(now.getTime()+15*60000); if(earliest>start)start=new Date(earliest); }
          var mp=start.getMinutes()%15; if(mp!==0)start=new Date(start.getTime()+(15-mp)*60000);
          var slot=new Date(start);
          while(slot<close && slots.length<50){ slots.push({label:fmtSlot(slot),sched:fmtScheduled(day.date,slot),iso:slot.toISOString()}); slot=new Date(slot.getTime()+15*60000); }
        }
      }
      tSlotsByDay.push({date:day.date, label:dayChipLabel(day.date,idx), slots:slots, idx:idx});
    });
  }
  function renderDays(){
    $('tDays').innerHTML=tSlotsByDay.map(function(d,i){return '<button class="tchip '+(i===tSelDay?'active':'')+'" data-tday="'+i+'">'+esc(d.label)+'</button>';}).join('');
  }
  function renderSlots(){
    var d=tSlotsByDay[tSelDay]; if(!d){$('tSlots').innerHTML='<div class="empty">Closed on this day.</div>';return;}
    var rows='';
    var s=sched[store&&store.id];
    if(d.idx===0 && s && s.isAcceptingOrders){ rows+='<div class="tslot '+(tSelSlot==='asap'?'sel':'')+'" data-tslot="asap"><span>ASAP</span><div class="mk"></div></div>'; }
    if(!d.slots.length && !rows){ $('tSlots').innerHTML='<div class="empty">'+(d.idx===0?'No more pickup slots today.':'Closed on this day.')+'</div>'; return; }
    rows+=d.slots.map(function(sl,i){return '<div class="tslot '+(tSelSlot===d.idx+'_'+i?'sel':'')+'" data-tslot="'+d.idx+'_'+i+'"><span>'+esc(sl.label)+'</span><div class="mk"></div></div>';}).join('');
    $('tSlots').innerHTML=rows;
  }
  function openTimePicker(){
    if(pickupMode==='in_store')return;
    buildSlots(); tSelDay=0; tSelSlot=null; renderDays(); renderSlots();
    $('timePicker').classList.add('open');
  }
  function closeTimePicker(){ $('timePicker').classList.remove('open'); }
  function applyTimeSelection(){
    if(tSelSlot==='asap'){ scheduled=null; }
    else if(tSelSlot){ var p=tSelSlot.split('_'),d=tSlotsByDay[+p[0]],sl=d&&d.slots[+p[1]]; if(sl)scheduled={label:sl.sched,iso:sl.iso}; }
    closeTimePicker(); refreshCheckoutState();
  }

  function openModal(i){
    var it=(MENU[activeCat]||[])[i];if(!it)return;modal=it;mq=1;mSel={};mGroups=[];
    $('mPh').style.cssText=picStyle(imgUrl(it.img));
    $('mName').textContent=it.n;$('mDesc').textContent=it.d||'';
    $('mPts').textContent=it.bowl?'Earn 1 berry':(it.cup?'Earn 1 cup':'Earn points');
    $('mOpts').innerHTML='<div class="empty">Loading options…</div>';
    $('mQ').textContent=1;updMPrice();$('scrim').classList.add('open');
    api('get-menu-item-detail',{id:it.id}).then(function(d){
      mGroups=((d&&d.menuModifierGroups)||[]).filter(function(g){return g.visibileOnline!==false&&(g.modifierItems||[]).length;});
      renderOpts();
    }).catch(function(){$('mOpts').innerHTML='';});
  }
  var PREVIEW=3;
  function grpItems(g){return (g.modifierItems||[]).filter(function(x){return x.active!==false;});}
  // Single-choice when POSCRAFT max==1 (Milk/Coffee Options): show fully, no
  // truncation (you pick exactly one). Multi-select (max==-1, the long Extras/
  // Wellness lists): show 3 + "Show more". Matches JTJ's type-aware rule, with
  // the app's show-3 + bottom-sheet component.
  function isSingleChoice(g){return g && g.max === 1;}
  function optRow(gi,xi,x){
    var pr=(x.salePrice||0)>0?('<div class="op">+'+f(x.salePrice)+'</div>'):'';
    var sel=mSel[gi+'_'+xi]?' sel':'';
    return '<div class="orow'+sel+'" data-g="'+gi+'" data-x="'+xi+'"><div class="ol">'+esc(x.name)+'</div>'+pr+'<div class="mk"></div></div>';
  }
  function renderOpts(){
    if(!mGroups.length){$('mOpts').innerHTML='';updMPrice();return;}
    $('mOpts').innerHTML=mGroups.map(function(g,gi){
      var items=grpItems(g), single=isSingleChoice(g);
      var rows;
      if(single || items.length<=PREVIEW){
        rows=items.map(function(x,xi){return optRow(gi,xi,x);}).join('');
      } else {
        // preview first 3, plus any selected item beyond the preview so a chosen
        // extra never disappears, then a Show more button.
        var shown={};
        rows=items.slice(0,PREVIEW).map(function(x,xi){shown[xi]=1;return optRow(gi,xi,x);}).join('');
        rows+=items.map(function(x,xi){return (!shown[xi]&&mSel[gi+'_'+xi])?optRow(gi,xi,x):'';}).join('');
        rows+='<button class="showmore" data-more="'+gi+'">Show more <span class="sm-arrow">&rarr;</span></button>';
      }
      var req=single?'Choose 1':'Optional';
      return '<div class="opt-grp"><div class="gh"><b>'+esc(g.name)+'</b><span>'+req+'</span></div>'+rows+'</div>';
    }).join('');
    updMPrice();
  }

  // "Show more" bottom-sheet: full list of one group, with prices + a confirm.
  function openMoreSheet(gi){
    var g=mGroups[gi]; if(!g)return;
    $('moreSheet').dataset.g=gi;
    $('msTitle').textContent=g.name.toUpperCase();
    renderMoreSheet();
    $('moreSheet').classList.add('open');
  }
  function renderMoreSheet(){
    var gi=+$('moreSheet').dataset.g, g=mGroups[gi]; if(!g)return;
    $('msList').innerHTML=grpItems(g).map(function(x,xi){return optRow(gi,xi,x);}).join('');
    var extra=modUnit()-modal.p; // running add-ons total across all groups
    $('msConfirm').textContent='Confirm add-ons '+f(extra);
  }
  function closeMoreSheet(){$('moreSheet').classList.remove('open');}
  function modUnit(){
    var extra=0;Object.keys(mSel).forEach(function(k){if(!mSel[k])return;var p=k.split('_'),g=mGroups[+p[0]];if(!g)return;var x=grpItems(g)[+p[1]];if(x)extra+=x.salePrice||0;});
    return modal.p+extra;
  }
  function selectedNames(){
    var out=[];Object.keys(mSel).forEach(function(k){if(!mSel[k])return;var p=k.split('_'),g=mGroups[+p[0]];if(!g)return;var x=grpItems(g)[+p[1]];if(x)out.push(x.name);});
    return out;
  }
  function updMPrice(){$('mPrice').textContent=f(modUnit()*mq);}
  function closeModal(){$('scrim').classList.remove('open');}

  function renderCart(){
    var html=cart.length?cart.map(function(c,i){
      return '<div class="line"><div class="qty"><button data-cm="'+i+'">−</button><span class="n">'+c.q+'</span><button data-cp="'+i+'">+</button></div><div class="nm">'+esc(c.n)+'<div class="ex">'+(c.extras.length?esc(c.extras.join(', ')):'No extras')+'</div></div><div class="pr">'+f(c.unit*c.q)+'</div></div>';
    }).join(''):'<div class="empty">Your basket is empty</div>';
    $('cartLines').innerHTML=html;
    var basket=$('coBasket');if(basket)basket.innerHTML=cart.length?html:'';
    var sub=cart.reduce(function(s,c){return s+c.unit*c.q;},0),n=cart.reduce(function(s,c){return s+c.q;},0),bowls=cart.reduce(function(s,c){return s+(c.bowl?c.q:0);},0);
    $('reviewBtn').className='cta'+(n?'':' disabled');$('reviewBtn').innerHTML=n?('Review order · '+f(sub)):'Review order';
    $('berryBar').innerHTML=bowls?('🫐 You will earn '+bowls+' berr'+(bowls>1?'ies':'y')+'. '+Math.max(0,9-bowls)+' more to a free bowl'):'🫐 Add a bowl to earn your next berry';
    $('coSub').textContent=f(sub);$('coTotal').textContent=f(sub);$('payTot').textContent=f(sub);
    $('coCount').textContent=n+' item'+(n!==1?'s':'');
    var mb=$('mobileBar');
    var onShop = $('checkout').style.display !== 'block'; // hide the review bar once in checkout
    if(n && onShop){mb.className='mbar show';mb.innerHTML='<span>'+n+' item'+(n!==1?'s':'')+'</span><span>Review order · '+f(sub)+'</span>';}
    else mb.className='mbar';
  }

  function setStoreLabels(){
    if(!store)return;
    document.querySelectorAll('[data-storename]').forEach(function(el){el.textContent=shortName(store.name);});
    document.querySelectorAll('[data-storeaddr]').forEach(function(el){el.textContent=[store.addressLine1,store.postCode].filter(Boolean).join(', ')||'Collection point';});
  }
  function renderPicker(q){
    q=(q||'').toLowerCase();
    var rows=LOC.filter(function(l){return shortName(l.name).toLowerCase().indexOf(q)>=0||(l.addressLine1||'').toLowerCase().indexOf(q)>=0;}).map(function(l){
      var s=sched[l.id], st=s?((s.isAcceptingOrders?'Open':'Closed')+(s.todayOpeningHours?(' · '+s.todayOpeningHours):'')):'';
      var addr=[l.addressLine1,l.countyTown,l.postCode].filter(Boolean).join(', ');
      return '<div class="prow" data-loc="'+l.id+'"><div><div class="pn">'+esc(shortName(l.name))+'</div><div class="pa">'+esc(addr)+'</div><div class="ps '+(s&&s.isAcceptingOrders?'open is-open':'open')+'">'+esc(st)+'</div></div><div class="pchev">›</div></div>';
    }).join('');
    $('pList').innerHTML=rows||'<div class="empty">No stores found</div>';
  }
  function openPicker(){
    $('storePicker').classList.add('open');renderPicker('');
    Promise.all(LOC.map(function(l){return sched[l.id]?Promise.resolve():api('get-ordering-schedule',{locationId:l.id}).then(function(s){sched[l.id]=s;}).catch(function(){});})).then(function(){renderPicker($('pSearch').value);});
  }
  function closePicker(){$('storePicker').classList.remove('open');}
  function doPickStore(l){ store=l; closePicker(); scheduled=null; setMode(pickupMode); setStoreLabels(); loadSchedule(); loadMenu(); }
  function pickStore(id){
    var l=LOC.filter(function(x){return x.id===id;})[0];if(!l)return;
    if(l.id===(store&&store.id)){ closePicker(); return; } // same store, no-op
    if(cart.length){ // app shows confirm + clears basket on store change
      confirmDialog('Clear cart?','Switching stores will clear your current cart. Do you want to continue?',function(){
        cart=[]; renderCart(); doPickStore(l); toast('Basket cleared due to store change');
      });
    } else { doPickStore(l); }
  }
  function useLocation(){
    if(!navigator.geolocation)return;
    navigator.geolocation.getCurrentPosition(function(pos){
      var la=pos.coords.latitude,lo=pos.coords.longitude,best=null,bd=1e9;
      LOC.forEach(function(l){if(l.latitude==null||l.longitude==null)return;var dx=(l.latitude-la),dy=(l.longitude-lo),d=dx*dx+dy*dy;if(d<bd){bd=d;best=l;}});
      if(best)pickStore(best.id);
    });
  }

  document.addEventListener('click',function(e){
    var t=e.target.closest('[data-cat],[data-i],[data-cm],[data-cp],[data-g],[data-more],[data-loc],[data-mode],[data-tday],[data-tslot]');
    if(!t)return;
    if(t.dataset.cat!==undefined){activeCat=t.dataset.cat;renderCats();renderMenu();window.scrollTo({top:300,behavior:'smooth'});}
    else if(t.dataset.i!==undefined){openModal(+t.dataset.i);}
    else if(t.dataset.more!==undefined){openMoreSheet(+t.dataset.more);}
    else if(t.dataset.g!==undefined){
      var gi=+t.dataset.g, x=grpItems(mGroups[gi])[+t.dataset.x], k=gi+'_'+t.dataset.x;
      // single-choice (max==1): pick one, clearing the group's other selections
      if(mGroups[gi] && mGroups[gi].max===1){ var n=grpItems(mGroups[gi]).length; for(var j=0;j<n;j++) delete mSel[gi+'_'+j]; mSel[k]=true; }
      else { mSel[k]=!mSel[k]; }
      updMPrice();
      // reflect in whichever surfaces are open (sheet + modal stay in sync)
      if($('moreSheet').classList.contains('open')){ renderMoreSheet(); }
      renderOpts();
    }
    else if(t.dataset.loc!==undefined){pickStore(+t.dataset.loc);}
    else if(t.dataset.mode!==undefined){setMode(t.dataset.mode);}
    else if(t.dataset.tday!==undefined){tSelDay=+t.dataset.tday;tSelSlot=null;renderDays();renderSlots();}
    else if(t.dataset.tslot!==undefined){tSelSlot=t.dataset.tslot;renderSlots();}
    else if(t.dataset.cm!==undefined){var i=+t.dataset.cm;cart[i].q--;if(cart[i].q<1)cart.splice(i,1);renderCart();}
    else if(t.dataset.cp!==undefined){cart[+t.dataset.cp].q++;renderCart();}
  });
  $('mClose').onclick=closeModal;
  $('scrim').onclick=function(e){if(e.target===$('scrim'))closeModal();};
  $('storePicker').onclick=function(e){if(e.target===$('storePicker'))closePicker();};
  $('mMinus').onclick=function(){mq=Math.max(1,mq-1);$('mQ').textContent=mq;updMPrice();};
  $('mPlus').onclick=function(){mq++;$('mQ').textContent=mq;updMPrice();};
  $('mAdd').onclick=function(){cart.push({n:modal.n,unit:modUnit(),q:mq,bowl:modal.bowl||0,cup:modal.cup||0,extras:selectedNames()});closeModal();renderCart();};
  $('openPicker').onclick=openPicker;
  $('changeStore2').onclick=openPicker;
  $('pClose').onclick=closePicker;
  $('pUseLoc').onclick=useLocation;
  $('pSearch').oninput=function(){renderPicker(this.value);};
  $('msClose').onclick=closeMoreSheet;
  $('msConfirm').onclick=closeMoreSheet;
  $('moreSheet').onclick=function(e){if(e.target===$('moreSheet'))closeMoreSheet();};
  $('timeField').onclick=openTimePicker;
  $('tClose').onclick=closeTimePicker;
  $('tDone').onclick=applyTimeSelection;
  $('timePicker').onclick=function(e){if(e.target===$('timePicker'))closeTimePicker();};
  $('cCancel').onclick=closeConfirm;
  $('cGo').onclick=function(){var cb=_confirmCb;closeConfirm();if(cb)cb();};
  $('confirmDlg').onclick=function(e){if(e.target===$('confirmDlg'))closeConfirm();};
  function toCheckout(){if(!cart.length)return;$('shop').style.display='none';$('checkout').style.display='block';$('mobileBar').className='mbar';refreshCheckoutState();window.scrollTo(0,0);}
  $('reviewBtn').onclick=toCheckout;
  $('mobileBar').onclick=toCheckout;
  $('backBtn').onclick=function(){$('shop').style.display='block';$('checkout').style.display='none';renderCart();window.scrollTo(0,0);};
  $('payBtn').onclick=function(){if(!canOrder())return;alert('Demo only. Stripe checkout wires up when we go live.');};

  api('get-locations').then(function(l){LOC=l.filter(function(x){return x&&x.onlineOrderingActive!==false;});store=LOC.filter(function(x){return x.id===1;})[0]||LOC[0];})
   .catch(function(){store={id:1,name:'The Acai Club - Reading'};LOC=[store];})
   .then(function(){setStoreLabels();renderCart();return Promise.all([loadSchedule(),loadMenu()]);});
})();
</script>
