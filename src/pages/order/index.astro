  // ---- server-authoritative totals (order-quote) ----
  // The client never computes the money the customer is asked to pay: every
  // cart change re-quotes server-side (debounced). Client math above is only
  // the instant preview while the quote is in flight.
  var qTimer=null,qSeq=0,lastQuote=null;
  function scheduleQuote(){
    lastQuote=null;
    if(qTimer)clearTimeout(qTimer);
    if(!cart.length||!store)return;
    qTimer=setTimeout(requestQuote,400);
  }
  function requestQuote(){
    var seq=++qSeq;
    var items=cart.filter(function(c){return c.pid!=null;}).map(function(c){return {productId:c.pid,quantity:c.q,modifierIds:c.modIds||[]};});
    if(items.length!==cart.length){console.warn('order-quote skipped: cart line without productId');return;}
    freshToken().then(function(tok){
      return ensureLinked(tok).then(function(){
        var intent={locationId:store.id,items:items};
        // drop a redemption the basket no longer supports, so the quote never errors
        if(!cart.some(function(c){return c.bowl;}))redeem.freeBowls=0;
        if(!cart.some(function(c){return c.cup;}))redeem.freeDrinks=0;
        if(redeem.freeBowls||redeem.freeDrinks)intent.redeem=redeem;
        if(couponCode)intent.couponCode=couponCode;
        return api('order-quote',intent,tok);
      });
    }).then(function(q){
      if(seq!==qSeq||!q||typeof q.total!=='number')return; // stale response or bad shape
      lastQuote=q;setCouponMsg('');applyQuote(q);
    }).catch(function(err){
      if(seq!==qSeq)return;
      // coupon/redeem rejections come back as EngineError codes; surface + retry clean
      if(err&&(String(err.code||'').indexOf('COUPON')===0)){ setCouponMsg(err.message||'Code not valid','err'); couponCode=''; scheduleQuote(); return; }
      if(err&&err.status===401&&(redeem.freeBowls||redeem.freeDrinks)){ redeem={freeBowls:0,freeDrinks:0}; scheduleQuote(); return; }
      console.warn('order-quote failed, showing client preview',err);
    });
  }
  function setCouponMsg(t,cls){ var m=$('couponMsg'); if(m){m.textContent=t||'';m.className='authmsg'+(cls?' '+cls:'');} }
  function applyQuote(q){
    // If a Payment Element is already mounted, the order just changed (redeem,
    // coupon, etc.), so the locked PaymentIntent amount is now stale. Tear it
    // down and make the customer re-tap Order & pay for a fresh, correct charge.
    if(elements){ resetPayUI(); setPayMsg('Your order changed. Tap Order & pay again.'); }
    $('coSub').textContent=f(q.subtotal);$('coTotal').textContent=f(q.total);$('payTot').textContent=f(q.total);
    var n=cart.reduce(function(s,c){return s+c.q;},0);
    var onShop = $('checkout').style.display !== 'block';
    if(n && onShop){var mb=$('mobileBar');mb.innerHTML='<span>'+n+' item'+(n!==1?'s':'')+'</span><span>Review order · '+f(q.total)+'</span>';}
    $('reviewBtn').innerHTML=n?('Review order · '+f(q.total)):'Review order';
    // discount rows between subtotal and total
    var rows='';
    if(q.rewardDiscount>0)rows+='<div class="totrow disc"><span>Reward redeemed</span><span>−'+f(q.rewardDiscount)+'</span></div>';
    if(q.couponDiscount>0)rows+='<div class="totrow disc"><span>Discount'+(q.coupon&&q.coupon.code?' ('+esc(q.coupon.code)+')':'')+'</span><span>−'+f(q.couponDiscount)+'</span></div>';
    $('quoteRows').innerHTML=rows;
    if(q.couponDiscount>0)setCouponMsg('Code applied','ok');
    var bal=q.loyalty&&q.loyalty.balance;
    // redemption offers (signed-in with available rewards, or an active redemption)
    var rb='';
    if(bal){
      // Only offer a free-bowl/-drink redemption when the basket actually has an
      // eligible item to apply it to (a water bottle is neither, so no offer).
      var hasBowl=cart.some(function(i){return i.bowl;});
      var hasDrink=cart.some(function(i){return i.cup;});
      if(hasBowl&&(bal.freeBowlsAvailable>0||redeem.freeBowls))rb+='<label class="redeemcard"><input type="checkbox" id="redeemBowl" '+(redeem.freeBowls?'checked':'')+'/> '+rwImg('berry')+' Free bowl available. Redeem it on this order</label>';
      if(hasDrink&&(bal.freeDrinksAvailable>0||redeem.freeDrinks))rb+='<label class="redeemcard"><input type="checkbox" id="redeemDrink" '+(redeem.freeDrinks?'checked':'')+'/> '+rwImg('cup')+' Free drink available. Redeem it on this order</label>';
    }
    $('redeemBox').innerHTML=rb;
    var rbow=$('redeemBowl'); if(rbow)rbow.onchange=function(){redeem.freeBowls=this.checked?1:0;scheduleQuote();};
    var rdr=$('redeemDrink'); if(rdr)rdr.onchange=function(){redeem.freeDrinks=this.checked?1:0;scheduleQuote();};
    // berry bar + signed-in balance note
    var earned=(q.loyalty&&q.loyalty.berriesEarned)||0;
    if(bal){
      $('berryBar').innerHTML=rwImg('berry')+' '+bal.berriesProgress+'/9 berries · '+rwImg('cup')+' '+bal.cupsProgress+'/9 cups'+(earned?(' · +'+earned+' berr'+(earned>1?'ies':'y')+' on this order'):'');
      var bn=$('balanceNote'); if(bn)bn.innerHTML=rwImg('berry')+' '+bal.berriesProgress+'/9 berries · '+rwImg('cup')+' '+bal.cupsProgress+'/9 cups'+(bal.freeBowlsAvailable?(' · '+bal.freeBowlsAvailable+' free bowl'+(bal.freeBowlsAvailable>1?'s':'')+' available'):'');
    } else {
      $('berryBar').innerHTML=earned?(rwImg('berry')+' You will earn '+earned+' berr'+(earned>1?'ies':'y')+'. '+Math.max(0,9-earned)+' more to a free bowl'):(rwImg('berry')+' Add a bowl to earn your next berry');
    }
  }

