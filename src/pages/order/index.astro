  function modUnit(){
    var extra=0;Object.keys(mSel).forEach(function(k){if(!mSel[k])return;var p=k.split('_'),g=mGroups[+p[0]];if(!g)return;var x=grpItems(g)[+p[1]];if(x)extra+=x.salePrice||0;});
    return modal.p+extra;
  }
  function selectedNames(){
    var out=[];Object.keys(mSel).forEach(function(k){if(!mSel[k])return;var p=k.split('_'),g=mGroups[+p[0]];if(!g)return;var x=grpItems(g)[+p[1]];if(x)out.push(x.name);});
    return out;
