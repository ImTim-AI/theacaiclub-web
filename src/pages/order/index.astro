---
// Web ordering is NOT launched yet. This route is intentionally unwired:
// it redirects to the live ordering site (order.theacaiclub.com) so any
// direct hit, cached nav link, bookmark, or QR lands on the working order
// flow instead of the half-built in-house page. The full /order build lives
// in git history (web-ordering branch) and will be restored at launch.
const DEST = "https://order.theacaiclub.com";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${DEST}`} />
    <link rel="canonical" href={DEST} />
    <meta name="robots" content="noindex" />
    <title>Order — The Açai Club</title>
    <script is:inline define:vars={{ DEST }}>window.location.replace(DEST);</script>
  </head>
  <body>
    <p>Redirecting to <a href={DEST}>order.theacaiclub.com</a>…</p>
  </body>
</html>
