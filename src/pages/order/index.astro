  function selectedModIds(){
    var out=[];Object.keys(mSel).forEach(function(k){if(!mSel[k])return;var p=k.split('_'),g=mGroups[+p[0]];if(!g)return;var x=grpItems(g)[+p[1]];if(x&&x.id!=null)out.push(x.id);});
    return out;
  }
  function updMPrice(){$('mPrice').textContent=f(modUnit()*mq);}
  function closeModal(){$('scrim').classList.remove('open');}

  function renderCart(){
    saveCart();
    var html=cart.length?cart.map(function(c,i){
      return '<div class="line"><div class="qty"><button data-cm="'+i+'">−</button><span class="n">'+c.q+'</span><button data-cp="'+i+'">+</button></div><div class="nm">'+esc(c.n)+'<div class="ex">'+(c.extras.length?esc(c.extras.join(', ')):'No extras')+'</div></div><div class="pr">'+f(c.unit*c.q)+'</div></div>';
    }).join(''):'<div class="empty">Your basket is empty</div>';
    $('cartLines').innerHTML=html;
    var basket=$('coBasket');if(basket)basket.innerHTML=cart.length?html:'';
    var sub=cart.reduce(function(s,c){return s+c.unit*c.q;},0),n=cart.reduce(function(s,c){return s+c.q;},0),bowls=cart.reduce(function(s,c){return s+(c.bowl?c.q:0);},0);
    $('reviewBtn').className='cta'+(n?'':' disabled');$('reviewBtn').innerHTML=n?('Review order · '+f(sub)):'Review order';
    $('berryBar').innerHTML=bowls?(rwImg('berry')+' You will earn '+bowls+' berr'+(bowls>1?'ies':'y')+'. '+Math.max(0,9-bowls)+' more to a free bowl'):(rwImg('berry')+' Add a bowl to earn your next berry');
    // client math is the INSTANT PREVIEW only; order-quote (server-authoritative)
    // overwrites these as soon as it returns (see applyQuote).
    $('coSub').textContent=f(sub);$('coTotal').textContent=f(sub);$('payTot').textContent=f(sub);
    $('coCount').textContent=n+' item'+(n!==1?'s':'');
    var mb=$('mobileBar');
    var onShop = $('checkout').style.display !== 'block'; // hide the review bar once in checkout
    if(n && onShop){mb.className='mbar show';mb.innerHTML='<span>'+n+' item'+(n!==1?'s':'')+'</span><span>Review order · '+f(sub)+'</span>';}
    else mb.className='mbar';
    scheduleQuote();
