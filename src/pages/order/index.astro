  // ---- pickup-time picker ----
  // Slots come from get-timeslots (server-generated in Europe/London from the
  // POSCRAFT schedule). Render slot.label ONLY; slot.iso is the POSCRAFT
  // wall-clock-as-UTC convention, kept opaque and passed through to order-pay.
  // The old client-side parser (openingHours string) stays as a fallback if the
  // function is unreachable.
  function buildSlotsFromServer(days){
    tSlotsByDay=days.map(function(day,idx){
      return {date:day.date, label:dayChipLabel(day.date,idx), idx:idx,
        slots:(day.slots||[]).map(function(sl){return {label:sl.label, sched:fmtScheduled(day.date,sl.label), iso:sl.iso};})};
    });
  }
  function buildSlotsLocal(){
    tSlotsByDay=[];
    var s=sched[store&&store.id]; if(!s||!Array.isArray(s.days))return;
    var now=ukNow();
    s.days.forEach(function(day,idx){
      var hrs=(day.openingHours||'').split('-'); var slots=[];
      if(hrs.length===2){
        var o=parseClock(hrs[0]), c=parseClock(hrs[1]);
        if(o&&c){
          var base=new Date(day.date+'T00:00:00');
          var open=new Date(base); open.setHours(o.h,o.m,0,0);
          var close=new Date(base); close.setHours(c.h,c.m,0,0);
          var start=open;
          if(idx===0){ var earliest=new Date(now.getTime()+15*60000); if(earliest>start)start=new Date(earliest); }
          var mp=start.getMinutes()%15; if(mp!==0)start=new Date(start.getTime()+(15-mp)*60000);
          var slot=new Date(start);
          while(slot<close && slots.length<50){ var lb=fmtSlot(slot); slots.push({label:lb,sched:fmtScheduled(day.date,lb),iso:slot.toISOString()}); slot=new Date(slot.getTime()+15*60000); }
        }
      }
      tSlotsByDay.push({date:day.date, label:dayChipLabel(day.date,idx), slots:slots, idx:idx});
    });
  }
  function renderDays(){
    $('tDays').innerHTML=tSlotsByDay.map(function(d,i){return '<button class="tchip '+(i===tSelDay?'active':'')+'" data-tday="'+i+'">'+esc(d.label)+'</button>';}).join('');
  }
  function renderSlots(){
    var d=tSlotsByDay[tSelDay]; if(!d){$('tSlots').innerHTML='<div class="empty">Closed on this day.</div>';return;}
    var rows='';
    var s=sched[store&&store.id];
    if(d.idx===0 && s && s.isAcceptingOrders){ rows+='<div class="tslot '+(tSelSlot==='asap'?'sel':'')+'" data-tslot="asap"><span>ASAP</span><div class="mk"></div></div>'; }
    if(!d.slots.length && !rows){ $('tSlots').innerHTML='<div class="empty">'+(d.idx===0?'No more pickup slots today.':'Closed on this day.')+'</div>'; return; }
    rows+=d.slots.map(function(sl,i){return '<div class="tslot '+(tSelSlot===d.idx+'_'+i?'sel':'')+'" data-tslot="'+d.idx+'_'+i+'"><span>'+esc(sl.label)+'</span><div class="mk"></div></div>';}).join('');
    $('tSlots').innerHTML=rows;
  }
  function openTimePicker(){
    if(pickupMode==='in_store')return;
    tSelDay=0; tSelSlot=null; tSlotsByDay=[];
    $('tDays').innerHTML=''; $('tSlots').innerHTML='<div class="empty">Loading pickup times…</div>';
    $('timePicker').classList.add('open');
    var sid=store&&store.id;
    api('get-timeslots',{locationId:sid}).then(function(r){
      if((store&&store.id)!==sid || !$('timePicker').classList.contains('open'))return; // store changed / closed meanwhile
      if(r&&Array.isArray(r.days)){ buildSlotsFromServer(r.days); } else { buildSlotsLocal(); }
      renderDays(); renderSlots();
    }).catch(function(){
      if((store&&store.id)!==sid || !$('timePicker').classList.contains('open'))return;
      buildSlotsLocal(); renderDays(); renderSlots();
    });
  }
  function closeTimePicker(){ $('timePicker').classList.remove('open'); }
  function applyTimeSelection(){
    if(tSelSlot==='asap'){ scheduled=null; }
    else if(tSelSlot){ var p=tSelSlot.split('_'),d=tSlotsByDay[+p[0]],sl=d&&d.slots[+p[1]]; if(sl)scheduled={label:sl.sched,iso:sl.iso}; }
    closeTimePicker(); refreshCheckoutState();
  }

  function openModal(i){
