  // ---- order mode + pickup time + closed gating (parity with app) ----
  function isAccepting(){ var s=sched[store&&store.id]; return !!(s&&s.isAcceptingOrders); }
  function canOrder(){ return isAccepting() || !!scheduled; }
  function setMode(mode){
    pickupMode=mode;
