  function useLocation(){
    if(!navigator.geolocation)return;
    navigator.geolocation.getCurrentPosition(function(pos){
      var la=pos.coords.latitude,lo=pos.coords.longitude,best=null,bd=1e9;
      LOC.forEach(function(l){if(l.latitude==null||l.longitude==null)return;var dx=(l.latitude-la),dy=(l.longitude-lo),d=dx*dx+dy*dy;if(d<bd){bd=d;best=l;}});
      if(best)pickStore(best.id);
    });
  }

  document.addEventListener('click',function(e){
    var t=e.target.closest('[data-cat],[data-i],[data-cm],[data-cp],[data-g],[data-more],[data-loc],[data-mode],[data-tday],[data-tslot]');
    if(!t)return;
    if(t.dataset.cat!==undefined){activeCat=t.dataset.cat;renderCats();renderMenu();window.scrollTo({top:300,behavior:'smooth'});}
    else if(t.dataset.i!==undefined){openModal(+t.dataset.i);}
    else if(t.dataset.more!==undefined){openMoreSheet(+t.dataset.more);}
    else if(t.dataset.g!==undefined){
      var gi=+t.dataset.g, x=grpItems(mGroups[gi])[+t.dataset.x], k=gi+'_'+t.dataset.x;
      // single-choice (max==1): pick one, clearing the group's other selections
      if(mGroups[gi] && mGroups[gi].max===1){ var n=grpItems(mGroups[gi]).length; for(var j=0;j<n;j++) delete mSel[gi+'_'+j]; mSel[k]=true; }
      else { mSel[k]=!mSel[k]; }
      updMPrice();
      // reflect in whichever surfaces are open (sheet + modal stay in sync)
      if($('moreSheet').classList.contains('open')){ renderMoreSheet(); }
      renderOpts();
    }
    else if(t.dataset.loc!==undefined){pickStore(+t.dataset.loc);}
    else if(t.dataset.mode!==undefined){setMode(t.dataset.mode);}
    else if(t.dataset.tday!==undefined){tSelDay=+t.dataset.tday;tSelSlot=null;renderDays();renderSlots();}
    else if(t.dataset.tslot!==undefined){tSelSlot=t.dataset.tslot;renderSlots();}
    else if(t.dataset.cm!==undefined){var i=+t.dataset.cm;cart[i].q--;if(cart[i].q<1)cart.splice(i,1);
      // emptying the basket while reviewing returns you to the menu
      if(!cart.length&&$('checkout').style.display==='block')backToMenu();else renderCart();}
    else if(t.dataset.cp!==undefined){cart[+t.dataset.cp].q++;renderCart();}
  });
  $('mClose').onclick=closeModal;
  $('scrim').onclick=function(e){if(e.target===$('scrim'))closeModal();};
  $('storePicker').onclick=function(e){if(e.target===$('storePicker'))closePicker();};
  $('mAdd').onclick=function(){cart.push({pid:modal.id,n:modal.n,unit:modUnit(),q:mq,bowl:modal.bowl||0,cup:modal.cup||0,extras:selectedNames(),modIds:selectedModIds()});closeModal();renderCart();};
  $('openPicker').onclick=openPicker;
  $('changeStore2').onclick=openPicker;
  $('pClose').onclick=closePicker;
  $('pUseLoc').onclick=useLocation;
  $('pSearch').oninput=function(){renderPicker(this.value);};
  $('msClose').onclick=closeMoreSheet;
  $('msConfirm').onclick=closeMoreSheet;
  $('moreSheet').onclick=function(e){if(e.target===$('moreSheet'))closeMoreSheet();};
  $('timeField').onclick=openTimePicker;
  $('tClose').onclick=closeTimePicker;
  $('tDone').onclick=applyTimeSelection;
  $('timePicker').onclick=function(e){if(e.target===$('timePicker'))closeTimePicker();};
  $('cCancel').onclick=closeConfirm;
  $('cGo').onclick=function(){var cb=_confirmCb;closeConfirm();if(cb)cb();};
  $('confirmDlg').onclick=function(e){if(e.target===$('confirmDlg'))closeConfirm();};
  function toCheckout(){if(!cart.length)return;$('shop').style.display='none';$('checkout').style.display='block';$('mobileBar').className='mbar';newCheckoutId();resetPayUI();refreshCheckoutState();if(!lastQuote)requestQuote();window.scrollTo(0,0);}
  $('reviewBtn').onclick=toCheckout;
  $('mobileBar').onclick=toCheckout;
  function backToMenu(){$('shop').style.display='block';$('checkout').style.display='none';renderCart();window.scrollTo(0,0);}
  $('backBtn').onclick=backToMenu;
  $('catPrev').onclick=function(){$('catRow').scrollBy({left:-280,behavior:'smooth'});};
  $('catNext').onclick=function(){$('catRow').scrollBy({left:280,behavior:'smooth'});};
  $('catRow').addEventListener('scroll',updateCatNav);
  window.addEventListener('resize',updateCatNav);
  // ---- payment (Stripe Payment Element, driven by order-pay) ----
  // Flow: "Order & pay" -> order-pay (server creates the pending order + PI) ->
  //   free order  -> process-order -> success
  //   paid order  -> mount Payment Element with the returned clientSecret ->
  //                  "Pay" -> stripe.confirmPayment (redirect:'if_required').
  // checkoutId is the order-pay idempotency key: one per checkout session, so a
  // retried "Order & pay" reuses the same PaymentIntent (never double-charges).
  var checkoutId=null, stripe=null, elements=null, paySubmitting=false;
  function uuid(){ return (crypto.randomUUID?crypto.randomUUID():(Date.now()+'-'+Math.random().toString(16).slice(2))); }
  function newCheckoutId(){ checkoutId=uuid(); }
  function setPayMsg(t,cls){ var m=$('payMsg'); if(m){m.textContent=t||'';m.className='authmsg'+(cls?' '+cls:'');} }
  function resetPayUI(){
    elements=null; paySubmitting=false;
    var pe=$('payElement'); if(pe){pe.style.display='none';pe.innerHTML='';}
    var cb=$('confirmPayBtn'); if(cb)cb.style.display='none';
    var pb=$('payBtn'); if(pb)pb.style.display='';
    setPayMsg('');
  }
  function stripeJs(){ return (typeof Stripe!=='undefined')?Stripe:null; }

  // Collect guest details (members are resolved server-side from their JWT).
  function guestDetails(){
    var name=($('custName').value||'').trim();
    var sp=name.split(/\s+/);
    var firstName=sp[0]||'', lastName=sp.slice(1).join(' ')||'';
    var email=($('authEmail').value||'').trim().toLowerCase();
    var phone=($('guestPhone').value||'').trim();
    return {firstName:firstName,lastName:lastName,email:email,phone:phone,optIn:false};
  }
  function intentItems(){
    return cart.filter(function(c){return c.pid!=null;}).map(function(c){return {productId:c.pid,quantity:c.q,modifierIds:c.modIds||[]};});
  }

  $('payBtn').onclick=function(){
    if(!canOrder()||paySubmitting)return;
    if(!$('termsChk').checked){ setPayMsg('Please accept the terms & conditions to continue.','err'); return; }
    if(!cart.length)return;
    var items=intentItems();
    if(items.length!==cart.length){ setPayMsg('Something is off with your basket. Please reload.','err'); return; }
    var g=null;
    if(!sess){
      g=guestDetails();
      if(!g.firstName||!g.lastName){ setPayMsg('Please enter your name for pick-up.','err'); $('custName').focus(); return; }
      if(!EMAIL_RE.test(g.email)){ setPayMsg('Please enter a valid email for your receipt.','err'); $('authEmail').focus(); return; }
    }
    paySubmitting=true; var btn=this; btn.disabled=true; setPayMsg('Setting up your order…');
    var body={
      locationId:store.id, items:items, checkoutId:checkoutId,
      notes:($('orderNotes').value||'').trim(),
      pickup: scheduled?{slotIso:scheduled.iso}:{mode:pickupMode},
    };
    if(redeem.freeBowls||redeem.freeDrinks)body.redeem=redeem;
    if(couponCode)body.couponCode=couponCode;
    if(g)body.guest=g;
    freshToken().then(function(tok){
      return ensureLinked(tok).then(function(){ return api('order-pay',body,tok); });
    }).then(function(r){
      if(r&&r.free){ return finishFreeOrder(r.orderToken); }
      if(r&&r.clientSecret){ return mountPayment(r.clientSecret); }
      throw new Error('Unexpected response');
    }).catch(function(e){
      paySubmitting=false; btn.disabled=false;
      if(e&&e.code==='EMAIL_REGISTERED'){ setPayMsg('That email already has an account. Sign in with a one-time code (your berries will count).','err'); return; }
      if(e&&e.code==='AUTH_REQUIRED'){ setPayMsg('Please sign in to redeem rewards.','err'); return; }
      if(e&&e.code==='BAD_PICKUP_TIME'){ setPayMsg('That pickup time is no longer available. Please pick a new time.','err'); return; }
      // show a structured server message; hide raw network errors behind a generic line
      var msg=(e&&e.code&&e.message)?e.message:'Could not start checkout. Please check your connection and try again.';
      setPayMsg(msg,'err');
    });
  };

  function finishFreeOrder(orderToken){
    setPayMsg('Placing your order…');
    return api('process-order',{orderToken:orderToken}).then(function(){
      orderPlaced();
    }).catch(function(){
      paySubmitting=false; $('payBtn').disabled=false;
      setPayMsg('Could not place your free order. Please try again.','err');
    });
  }

  function mountPayment(clientSecret){
    var S=stripeJs();
    if(!S){ paySubmitting=false; $('payBtn').disabled=false; setPayMsg('Payment failed to load. Please reload the page.','err'); return; }
    stripe=stripe||S(STRIPE_PK);
    elements=stripe.elements({clientSecret:clientSecret, appearance:{theme:'flat', variables:{colorPrimary:'#5B2C6F', borderRadius:'12px'}}});
    var pe=elements.create('payment',{layout:'tabs'});
    var box=$('payElement'); box.innerHTML=''; box.style.display='block'; pe.mount(box);
    $('payBtn').style.display='none';
    var cb=$('confirmPayBtn'); cb.style.display=''; cb.disabled=false;
    $('confirmTot').textContent=$('coTotal').textContent;
    setPayMsg('Enter your card details to finish.');
    paySubmitting=false;
    box.scrollIntoView({behavior:'smooth',block:'center'});
  }

  $('confirmPayBtn').onclick=function(){
    if(!elements||!stripe||paySubmitting)return;
    paySubmitting=true; var cb=this; cb.disabled=true; setPayMsg('Confirming payment…');
    stripe.confirmPayment({
      elements:elements,
      confirmParams:{ return_url: location.origin+'/order?paid=1' },
      redirect:'if_required',
    }).then(function(res){
      if(res.error){
        paySubmitting=false; cb.disabled=false;
        setPayMsg(res.error.message||'Payment was not completed. Please try again.','err');
        return;
      }
      // Paid. stripe-webhook pushes the order to the store on
      // payment_intent.succeeded; nothing else for the client to call.
      orderPlaced();
    }).catch(function(){
      paySubmitting=false; cb.disabled=false;
      setPayMsg('Something went wrong confirming payment. Please try again.','err');
    });
  };

  function orderPlaced(){
    // snapshot the order BEFORE clearing, so the confirmation can show it
    // (screenshot-friendly: store, items, pick-up time, total, rewards earned)
    var items=cart.slice();
    var total=(lastQuote&&typeof lastQuote.total==='number')?lastQuote.total:items.reduce(function(s,c){return s+c.unit*c.q;},0);
    var berries=items.reduce(function(s,c){return s+(c.bowl?c.q:0);},0);
    var cups=items.reduce(function(s,c){return s+(c.cup?c.q:0);},0);
    var when=($('timeText')&&$('timeText').textContent)||'ASAP';
    var sname=store?shortName(store.name):'';
    var saddr=store?[store.addressLine1,store.postCode].filter(Boolean).join(', '):'';
    cart=[]; redeem={freeBowls:0,freeDrinks:0}; couponCode='';
    var rows=items.map(function(c){
      return '<div class="cf-item"><span class="cf-q">'+c.q+'×</span><span class="cf-n">'+esc(c.n)+(c.extras&&c.extras.length?'<span class="cf-ex">'+esc(c.extras.join(', '))+'</span>':'')+'</span><span class="cf-p">'+f(c.unit*c.q)+'</span></div>';
    }).join('');
    var reward='';
    if(berries||cups){
      var parts=[];
      if(berries)parts.push(rwImg('berry')+' +'+berries+' berr'+(berries>1?'ies':'y'));
      if(cups)parts.push(rwImg('cup')+' +'+cups+' cup'+(cups>1?'s':''));
      reward='<div class="cf-reward">'+parts.join(' &nbsp;&nbsp; ')+' earned</div>';
    }
    var co=$('checkout');
    co.innerHTML='<div class="oa-wrap cf-wrap">'+
      '<div class="cf-emoji">🥥</div>'+
      '<h2 class="cf-h">Order placed</h2>'+
      '<p class="cf-sub2">Your order is with the store and will be ready at your pick-up time. Show this screen when you collect.</p>'+
      '<div class="cf-card">'+
        '<div class="cf-line"><span class="cf-lbl">Collect from</span><span class="cf-val">'+esc(sname)+'</span></div>'+
        (saddr?'<div class="cf-addr">'+esc(saddr)+'</div>':'')+
        '<div class="cf-line" style="margin-top:10px"><span class="cf-lbl">Pick-up</span><span class="cf-val">'+esc(when)+'</span></div>'+
        '<div class="cf-div"></div>'+
        '<div class="cf-items">'+rows+'</div>'+
        '<div class="cf-div"></div>'+
        '<div class="cf-line cf-tot"><span class="cf-lbl">Total paid</span><span class="cf-val">'+f(total)+'</span></div>'+
        reward+
      '</div>'+
      '<a href="/order" class="cta cf-cta">Start a new order</a>'+
    '</div>';
    window.scrollTo(0,0);
  }

  // ---- auth handlers ----
  var EMAIL_RE=/^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  $('sendCode').onclick=function(){
    var em=($('authEmail').value||'').trim().toLowerCase();
    if(!EMAIL_RE.test(em)){setAuthMsg('Enter a valid email address','err');return;}
    var b=this; b.disabled=true; setAuthMsg('Sending code…');
    aapi('/otp',{email:em,create_user:true}).then(function(){
      $('codeRow').style.display='flex'; setAuthMsg('Code sent. Check your email (it can take a minute).','ok'); $('authCode').focus();
    }).catch(function(e){
      setAuthMsg(e.status===429?'Too many codes requested. Try again in a few minutes.':'Could not send the code. Try again.','err');
    }).then(function(){ b.disabled=false; });
  };
  $('verifyCode').onclick=function(){
    var em=($('authEmail').value||'').trim().toLowerCase();
    var code=($('authCode').value||'').trim();
    if(!/^\d{6}$/.test(code)){setAuthMsg('Enter the 6-digit code from the email','err');return;}
    var b=this; b.disabled=true; setAuthMsg('Checking…');
    aapi('/verify',{type:'email',email:em,token:code}).then(function(r){
      sess={access_token:r.access_token,refresh_token:r.refresh_token,expires_at:r.expires_at||Math.floor(Date.now()/1000)+(r.expires_in||3600),email:(r.user&&r.user.email)||em};
      saveSess(); _linkP=null; renderAuth(); setAuthMsg('');
      if(cart.length)requestQuote(); // re-quote signed-in: balance + redemption offers appear
    }).catch(function(){
      setAuthMsg('That code didn\'t work. Check it or request a new one.','err');
    }).then(function(){ b.disabled=false; });
  };
  $('signOut').onclick=function(){
    sess=null; saveSess(); _linkP=null; redeem={freeBowls:0,freeDrinks:0};
    renderAuth(); $('redeemBox').innerHTML=''; renderCart();
  };
  $('couponApply').onclick=function(){
    var c=($('couponInput').value||'').trim();
    if(!c){couponCode='';setCouponMsg('');scheduleQuote();return;}
    if(!cart.length){setCouponMsg('Add something to your basket first','err');return;}
    couponCode=c; setCouponMsg('Checking code…'); requestQuote();
  };

  loadSess(); renderAuth();
  api('get-locations').then(function(l){LOC=l.filter(function(x){return x&&x.onlineOrderingActive!==false;});})
   .catch(function(){LOC=[{id:1,name:'The Acai Club - Reading'},{id:3,name:'The Acai Club - Beaconsfield'},{id:4,name:'The Acai Club - Datchet'}];})
   .then(function(){
     // Restore a previously chosen store + its basket (survives refresh).
     var saved=loadCart();
     var savedStore=saved&&saved.storeId?LOC.filter(function(x){return x.id===saved.storeId;})[0]:null;
     if(savedStore){
       store=savedStore;
       cart=Array.isArray(saved.cart)?saved.cart:[];
       setStoreLabels(); renderCart(); setMode(pickupMode);
       loadSchedule(); loadMenu();
       if(cart.length)scheduleQuote();
     } else {
       // No saved store: require an explicit choice first (parity with the app)
       // so a customer can never accidentally order from the wrong location.
       renderCart();
       document.querySelectorAll('[data-storename]').forEach(function(el){el.textContent='Select store';});
       $('menu').innerHTML='<div class="section"><div class="empty">Choose your store above to see the menu.</div></div>';
       openPicker();
     }
   });
})();
</script>
