---
// Web Store checkout. Card only (T, 2026-10-21): no wallet, no points, no
// rewards on the website. merch-checkout does every money decision; this page
// collects intent and hosts Stripe's Payment Element.
//
// Flow, after Baymard's checkout research and Stripe's Payment Element
// guidance:
//   one enclosed page (no site nav), linear sections, total visible from the
//   first screen, guest checkout (email for the receipt, no account), only the
//   fields the server needs, persistent labels, inline errors, an explained
//   phone field, data kept on error, a descriptive primary button, and a
//   confirmation that says what happens next.
import Layout from '../../layouts/Layout.astro';
import store from '../../data/store.json';
import '../../styles/store.css';

// Slim product facts for the client. Prices here are display only; the server
// prices the order and the page shows the server's total before payment.
const products = Object.fromEntries(
  store.products.map((p) => [
    p.slug,
    {
      slug: p.slug,
      name: p.name,
      pricePence: p.pricePence,
      preorder: p.preorder,
      expectedDispatchAt: p.expectedDispatchAt,
      isTee: p.categorySlug === 'clothing',
      colours: p.colours.map((c) => ({
        name: c.name,
        image: c.card[0]?.src ?? c.gallery[0]?.src ?? null,
        sizes: c.sizes.map((s) => ({ size: s.size, variantId: s.variantId })),
      })),
    },
  ]),
);
---

<Layout title="Checkout | The Açai Club Store" description="Checkout" noindex bare>
  <div class="store min-h-screen" id="co" data-products={JSON.stringify(products)}>
    <header class="co-head">
      <a href="/store" class="co-back" data-back aria-label="Back to the Store">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        <span>Store</span>
      </a>
      <a href="/" class="co-logo" aria-label="The Açai Club home"><img src="/images/logo.jpg" alt="" width="32" height="32" /></a>
      <span class="co-secure">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Secure checkout
      </span>
    </header>

    <div class="co-wrap">
      <!-- Shown when the link has no product or the product is gone. -->
      <section class="co-card co-empty" data-empty hidden>
        <h1 class="co-h1">That item is not available</h1>
        <p class="co-muted mt-2">It may have sold out or been removed.</p>
        <a href="/store" class="store-cta mt-5">Back to the Store</a>
      </section>

      <div class="co-grid" data-main hidden>
        <!-- Order summary: first on mobile, sticky right column on desktop -->
        <aside class="co-summary">
          <div class="co-card">
            <div class="co-item">
              <div class="co-thumb"><img data-item-img alt="" /></div>
              <div class="min-w-0 flex-1">
                <p class="co-item-name" data-item-name></p>
                <p class="co-muted text-[13px] mt-0.5" data-item-variant></p>
                <a class="co-link text-[13px] mt-1 inline-block" data-item-edit>Change</a>
              </div>
              <p class="co-item-price" data-item-price></p>
            </div>
            <p class="co-note mt-3" data-preorder hidden></p>
            <dl class="co-totals">
              <div><dt>Subtotal</dt><dd data-subtotal></dd></div>
              <div><dt data-ship-label>Collection</dt><dd data-ship></dd></div>
              <div class="co-total"><dt>Total</dt><dd data-total></dd></div>
            </dl>
            <p class="co-muted text-[12px] mt-2" data-total-note>Prices include VAT.</p>
          </div>
        </aside>

        <form class="co-form" novalidate data-form>
          <!-- 1. Email -->
          <section class="co-card" data-step="email">
            <div class="co-step-head">
              <h2 class="co-h2"><span class="co-num">1</span>Email</h2>
              <button type="button" class="co-link text-[13px]" data-signout hidden>Not you?</button>
            </div>
            <div data-email-out>
              <p class="co-muted text-[13px] mt-1">No account needed. Your receipt and order updates go here.</p>
              <label class="co-label mt-4" for="co-email">Email address</label>
              <input class="co-input" id="co-email" type="email" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" placeholder="you@example.com" />
              <p class="co-err" data-err="email" hidden></p>
            </div>
            <p class="co-done" data-email-in hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              <span data-who></span>
            </p>
          </section>

          <!-- 2. Collection or delivery -->
          <section class="co-card" data-step="fulfil">
            <h2 class="co-h2"><span class="co-num">2</span>Collection or delivery</h2>
            <div class="co-options mt-4" role="radiogroup" aria-label="Collection or delivery">
              <label class="co-option">
                <input type="radio" name="fulfilment" value="collection" checked />
                <span class="co-option-body"><b>Collect in store</b><small>We text you when it is ready</small></span>
                <span class="co-option-price">Free</span>
              </label>
              <label class="co-option">
                <input type="radio" name="fulfilment" value="delivery" />
                <span class="co-option-body"><b>UK delivery</b><small data-delivery-when>Posted from HQ, UK mainland</small></span>
                <span class="co-option-price">£4.99</span>
              </label>
            </div>

            <div data-collect class="mt-5">
              <p class="co-label">Collect from</p>
              <div class="co-stores mt-2" role="radiogroup" aria-label="Collect from" data-stores></div>
              <p class="co-err" data-err="store" hidden></p>
            </div>

            <div data-deliver class="mt-5" hidden>
              <label class="co-label" for="co-name">Full name</label>
              <input class="co-input" id="co-name" autocomplete="shipping name" />
              <p class="co-err" data-err="name" hidden></p>
              <label class="co-label mt-4" for="co-line1">Address</label>
              <input class="co-input" id="co-line1" autocomplete="shipping address-line1" placeholder="House number and street" />
              <p class="co-err" data-err="line1" hidden></p>
              <div class="co-row mt-4">
                <div>
                  <label class="co-label" for="co-city">Town or city</label>
                  <input class="co-input" id="co-city" autocomplete="shipping address-level2" />
                  <p class="co-err" data-err="city" hidden></p>
                </div>
                <div>
                  <label class="co-label" for="co-postcode">Postcode</label>
                  <input class="co-input" id="co-postcode" autocomplete="shipping postal-code" autocapitalize="characters" />
                  <p class="co-err" data-err="postcode" hidden></p>
                </div>
              </div>
              <p class="co-muted text-[12px] mt-2">UK mainland only for now.</p>
            </div>

            <label class="co-label mt-5" for="co-phone">Mobile number</label>
            <input class="co-input" id="co-phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="07..." />
            <p class="co-muted text-[12px] mt-1.5" data-phone-why>Only used to text you when your order is ready to collect. Never for marketing.</p>
            <p class="co-err" data-err="phone" hidden></p>

            <button type="button" class="store-cta co-btn mt-6" data-continue>Continue to payment</button>
            <p class="co-err" data-err="reserve" role="alert" hidden></p>
          </section>

          <!-- 3. Payment -->
          <section class="co-card" data-step="pay" data-locked>
            <div class="co-step-head">
              <h2 class="co-h2"><span class="co-num">3</span>Payment</h2>
              <button type="button" class="co-link text-[13px]" data-edit-details hidden>Edit details</button>
            </div>
            <p class="co-muted text-[13px] mt-1" data-pay-hint>Enter your details above to pay.</p>
            <div class="mt-4" data-payment-element></div>
            <p class="co-err" data-err="pay" role="alert" hidden></p>
            <button type="button" class="store-cta co-btn co-pay mt-5" data-pay hidden>Pay</button>
            <p class="co-muted text-[12px] mt-3 text-center" data-pay-fine hidden>Card payments are processed by Stripe. We never see or store your card number.</p>
          </section>

          <p class="co-muted text-[12px] text-center px-4" data-fineprint>
            <span data-returns>Unused T-shirts may be returned within 14 days. </span>By paying you agree to our <a href="/terms" class="co-link" target="_blank" rel="noopener">terms</a>.
          </p>
        </form>
      </div>

      <!-- Confirmation -->
      <section class="co-card co-confirm" data-confirm hidden>
        <div class="co-tick" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <h1 class="co-h1 mt-4">Thank you, your order is in</h1>
        <p class="co-muted mt-1">Order <b class="co-ink" data-c-code></b></p>
        <div class="co-item mt-5 text-left">
          <div class="co-thumb"><img data-c-img alt="" /></div>
          <div class="min-w-0 flex-1">
            <p class="co-item-name" data-c-name></p>
            <p class="co-muted text-[13px] mt-0.5" data-c-variant></p>
          </div>
          <p class="co-item-price" data-c-total></p>
        </div>
        <div class="co-next mt-5 text-left">
          <p class="co-label">What happens next</p>
          <p class="mt-1.5 text-[14px]" data-c-next></p>
          <p class="co-muted text-[13px] mt-2">A receipt is on its way to <span data-c-email></span>.</p>
        </div>
        <a href="/store" class="store-cta co-btn mt-6">Back to the Store</a>
      </section>
    </div>
  </div>
</Layout>

<script is:inline src="https://js.stripe.com/v3/"></script>

<script>
  import {
    ApiError, cancelCheckout, currentEmail, freshToken, liveVariants, loadSession,
    money, pickupStores, signOut, startCheckout, track, uuid,
  } from '../../lib/store-client';
  import { STRIPE_PK } from '../../lib/public-keys';

  type Product = {
    slug: string; name: string; pricePence: number; preorder: boolean; expectedDispatchAt: string | null; isTee: boolean;
    colours: { name: string; image: string | null; sizes: { size: string; variantId: string }[] }[];
  };

  const root = document.getElementById('co')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const show = (el: HTMLElement | null, on: boolean) => { if (el) el.hidden = !on; };
  const products: Record<string, Product> = JSON.parse(root.dataset.products!);
  const DELIVERY_PENCE = 499; // display only; the server's total is what is charged

  const params = new URLSearchParams(location.search);
  const product = products[params.get('product') ?? ''];
  const variantId = params.get('variant') ?? '';
  const colour = product?.colours.find((c) => c.sizes.some((s) => s.variantId === variantId));
  const size = colour?.sizes.find((s) => s.variantId === variantId)?.size;

  // Persisted form (Baymard: never make people retype after a refresh or error).
  const FORM_KEY = 'acai_store_checkout_form';
  const PENDING_KEY = 'acai_store_checkout_pending';
  const fields = ['co-email', 'co-name', 'co-line1', 'co-city', 'co-postcode', 'co-phone'];
  function saveForm() {
    const data: Record<string, string> = { fulfilment: fulfilment(), store: pickupId ?? '' };
    fields.forEach((id) => { data[id] = (document.getElementById(id) as HTMLInputElement).value; });
    try { localStorage.setItem(FORM_KEY, JSON.stringify(data)); } catch {}
  }
  function restoreForm(): Record<string, string> {
    try { return JSON.parse(localStorage.getItem(FORM_KEY) || '{}'); } catch { return {}; }
  }

  const productUrl = (p: Product, c?: string) => `/store/${p.slug}/${c ? `?colour=${encodeURIComponent(c)}` : ''}`;
  function dispatchDate(iso: string | null) {
    return iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'Europe/London' }) : null;
  }

  // ---------- state ----------
  let checkoutId = uuid();
  let pickupId: string | null = null;
  let quote: { orderId: string; orderCode: string; clientSecret: string; totalPence: number; deliveryPence: number } | null = null;
  let stripe: any = null;
  let elements: any = null;
  let confirming = false;
  let paid = false;

  function fulfilment(): 'collection' | 'delivery' {
    return (root.querySelector<HTMLInputElement>('input[name=fulfilment]:checked')?.value as any) ?? 'collection';
  }

  function err(key: string, msg: string | null) {
    const el = root.querySelector<HTMLElement>(`[data-err="${key}"]`);
    if (!el) return;
    el.textContent = msg ?? '';
    el.hidden = !msg;
    const input = { email: 'co-email', code: 'co-code', name: 'co-name', line1: 'co-line1', city: 'co-city', postcode: 'co-postcode', phone: 'co-phone' }[key];
    if (input) document.getElementById(input)?.setAttribute('aria-invalid', msg ? 'true' : 'false');
  }

  function renderTotals() {
    if (!product) return;
    const delivery = fulfilment() === 'delivery';
    const ship = quote ? quote.deliveryPence : delivery ? DELIVERY_PENCE : 0;
    const total = quote ? quote.totalPence : product.pricePence + ship;
    $('[data-subtotal]').textContent = money(product.pricePence);
    $('[data-ship-label]').textContent = delivery ? 'UK delivery' : 'Collection';
    $('[data-ship]').textContent = ship ? money(ship) : 'Free';
    $('[data-total]').textContent = money(total);
    $('[data-pay]').textContent = `Pay ${money(total)}`;
  }

  // ---------- 0. product ----------
  if (!product || !colour || !size) {
    show($('[data-empty]'), true);
    if (product) $<HTMLAnchorElement>('[data-empty] a').href = productUrl(product);
  } else {
    show($('[data-main]'), true);
    const img = $<HTMLImageElement>('[data-item-img]');
    if (colour.image) img.src = colour.image; else img.remove();
    $('[data-item-name]').textContent = product.name;
    $('[data-item-variant]').textContent = [product.colours.length > 1 ? colour.name : null, `Size ${size}`].filter(Boolean).join(' · ');
    $('[data-item-price]').textContent = money(product.pricePence);
    $<HTMLAnchorElement>('[data-item-edit]').href = productUrl(product, colour.name);
    $<HTMLAnchorElement>('[data-back]').href = productUrl(product, colour.name);
    if (!product.isTee) show($('[data-returns]'), false);
    if (product.preorder) {
      const d = dispatchDate(product.expectedDispatchAt);
      const note = $('[data-preorder]');
      note.textContent = d ? `Pre-order. Expected to dispatch by ${d}.` : 'Pre-order. Dispatch date to be confirmed.';
      show(note, true);
      if (d) $('[data-delivery-when]').textContent = `Posted from HQ by ${d}, UK mainland`;
    }
    renderTotals();
    track('Store Web Checkout Viewed', { product: product.slug, variant: variantId });
    // Live stock: the page is a snapshot, the shopper should not fill a form
    // for a size that has already gone.
    liveVariants(product.slug).then((live) => {
      const v = live.find((x) => x.id === variantId);
      if (!v || !v.available || !v.onSale) {
        err('reserve', v && !v.onSale ? 'This item is not on sale right now.' : 'That size has just sold out. Choose another size.');
        $<HTMLButtonElement>('[data-continue]').disabled = true;
      }
    }).catch(() => { /* the server checks again at reservation */ });
    boot();
  }

  // ---------- 1. email ----------
  // Guest checkout (Baymard: forced sign-in is a top abandonment cause). The
  // email is only where the receipt goes. Someone already signed in on this
  // site (e.g. from /order) checks out as themselves.
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  const emailInput = () => document.getElementById('co-email') as HTMLInputElement;
  const typedEmail = () => emailInput().value.trim().toLowerCase();
  const buyerEmail = () => currentEmail() ?? (EMAIL_RE.test(typedEmail()) ? typedEmail() : null);

  function renderAuth() {
    const who = currentEmail();
    show($('[data-email-out]'), !who);
    show($('[data-email-in]'), !!who);
    show($('[data-signout]'), !!who && !quote);
    $('[data-who]').textContent = who ?? '';
  }

  function checkEmail(): boolean {
    if (currentEmail()) return true;
    if (EMAIL_RE.test(typedEmail())) { err('email', null); return true; }
    err('email', typedEmail() ? 'Enter a valid email address, like name@example.com.' : 'Enter your email address for the receipt.');
    return false;
  }
  emailInput().addEventListener('blur', () => { if (typedEmail()) checkEmail(); });
  emailInput().addEventListener('input', () => { if (EMAIL_RE.test(typedEmail())) err('email', null); });
  $('[data-signout]').addEventListener('click', () => { signOut(); renderAuth(); emailInput().focus(); });

  // ---------- 2. fulfilment ----------
  function renderFulfilment() {
    const delivery = fulfilment() === 'delivery';
    show($('[data-collect]'), !delivery);
    show($('[data-deliver]'), delivery);
    $('[data-phone-why]').textContent = delivery
      ? 'Only used if the courier or we need to reach you about this order. Never for marketing.'
      : 'Only used to text you when your order is ready to collect. Never for marketing.';
    renderTotals();
  }
  root.querySelectorAll<HTMLInputElement>('input[name=fulfilment]').forEach((r) => r.addEventListener('change', () => { renderFulfilment(); saveForm(); }));
  fields.forEach((id) => document.getElementById(id)!.addEventListener('input', () => {
    saveForm();
    err(id.replace('co-', ''), null);
  }));

  function renderStores(list: { id: string; name: string }[]) {
    const box = $('[data-stores]');
    box.innerHTML = '';
    list.forEach((s) => {
      const label = document.createElement('label');
      label.className = 'co-store';
      const input = document.createElement('input');
      input.type = 'radio'; input.name = 'pickup'; input.value = s.id;
      input.checked = s.id === pickupId;
      input.addEventListener('change', () => { pickupId = s.id; err('store', null); saveForm(); });
      const span = document.createElement('span');
      span.textContent = s.name;
      label.append(input, span);
      box.append(label);
    });
  }

  function validate(): boolean {
    let ok = true;
    let first: HTMLElement | null = null;
    const need = (key: string, id: string, test: (v: string) => string | null) => {
      const el = document.getElementById(id) as HTMLInputElement;
      const msg = test(el.value.trim());
      err(key, msg);
      if (msg) { ok = false; first ??= el; }
    };
    if (fulfilment() === 'collection') {
      if (!pickupId) { err('store', 'Choose the shop you want to collect from.'); ok = false; first ??= $('[data-stores]'); }
    } else {
      need('name', 'co-name', (v) => (v ? null : 'Enter the name for the parcel.'));
      need('line1', 'co-line1', (v) => (v ? null : 'Enter the house number and street.'));
      need('city', 'co-city', (v) => (v ? null : 'Enter the town or city.'));
      need('postcode', 'co-postcode', (v) =>
        !v ? 'Enter the postcode.'
          : !/^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i.test(v) ? 'That postcode looks incomplete, like SL3 9AB.'
          : null);
    }
    need('phone', 'co-phone', (v) => {
      const digits = v.replace(/\D/g, '');
      if (!digits) return 'Enter a mobile number so we can reach you about this order.';
      if (digits.length < 7 || digits.length > 15) return 'That number looks too short or too long.';
      return null;
    });
    first?.focus();
    return ok;
  }

  // Server codes to plain next steps. Anything else shows the server's own
  // sentence, which merch-checkout guarantees is safe to print.
  function reserveMessage(e: ApiError): string {
    switch (e.code) {
      case 'MERCH_SOLD_OUT': return 'That size has just sold out. Choose another size.';
      case 'MERCH_ALREADY_OWNED': return 'You already have one of this design. It is one per person.';
      case 'MERCH_NOT_SIGNED_IN': return 'Your sign-in expired. Enter your email and try again.';
      case 'MERCH_GUEST_EMAIL_INVALID': return 'Enter a valid email address, like name@example.com.';
      case 'MERCH_RATE_LIMITED': return 'Too many attempts. Please wait a few minutes and try again. Nothing was charged.';
      case 'MERCH_POSTCODE_NOT_MAINLAND': return 'We only deliver to the UK mainland at the moment. You can collect in store instead.';
      case 'MERCH_PRICE_CHANGED': return 'The price changed while you were checking out. Reload the page to see the new total.';
      case 'MERCH_UNAVAILABLE': case 'HTTP_0': return 'We could not reach the Store. Check your connection and try again. Nothing was charged.';
      default: return e.message || 'We could not start checkout. Please try again. Nothing was charged.';
    }
  }

  function lockDetails(locked: boolean) {
    const s = $('[data-step="fulfil"]');
    s.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input, button').forEach((el) => { el.disabled = locked; });
    s.toggleAttribute('data-summary', locked);
    show($('[data-continue]'), !locked);
    show($('[data-edit-details]'), locked);
    show($('[data-signout]'), !locked && !!currentEmail());
    const ei = emailInput(); if (ei) ei.disabled = locked;
  }

  async function doContinue() {
    err('reserve', null);
    const emailOk = checkEmail();
    if (!validate() || !emailOk) { if (!emailOk) emailInput().focus(); return; }
    const b = $<HTMLButtonElement>('[data-continue]');
    b.disabled = true; b.textContent = 'Reserving your item…';
    const f = fulfilment();
    const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    try {
      const q = await startCheckout({
        checkoutId,
        variantId,
        fulfilment: f,
        phone: v('co-phone'),
        pickupStoreId: pickupId ?? undefined,
        shipName: v('co-name'),
        shipLine1: v('co-line1'),
        shipCity: v('co-city'),
        shipPostcode: v('co-postcode').toUpperCase(),
      }, currentEmail() ? null : typedEmail());
      quote = q;
      try { sessionStorage.setItem(PENDING_KEY, JSON.stringify({ ...q, product: product.slug, variantId, fulfilment: f, pickupId, email: buyerEmail() })); } catch {}
      renderTotals();
      lockDetails(true);
      mountPayment(q.clientSecret);
      track('Store Web Reserved', { product: product.slug, fulfilment: f, total: q.totalPence });
    } catch (e: any) {
      const ae = e instanceof ApiError ? e : new ApiError('', 'HTTP_0', 0);
      if (ae.code === 'MERCH_NOT_SIGNED_IN' && currentEmail()) { signOut(); renderAuth(); }
      // A new checkout id after any refusal: the old one may be spent.
      checkoutId = uuid();
      err('reserve', reserveMessage(ae));
      track('Store Web Reserve Failed', { code: ae.code });
    } finally {
      b.disabled = false; b.textContent = 'Continue to payment';
    }
  }
  $('[data-continue]').addEventListener('click', doContinue);

  // Changing details after reserving releases the unit and starts clean, so a
  // stale reservation never sits behind a different address or shop.
  $('[data-edit-details]').addEventListener('click', async () => {
    if (!quote || confirming) return;
    const held = quote;
    quote = null;
    teardownPayment();
    lockDetails(false);
    checkoutId = uuid();
    renderTotals();
    try { sessionStorage.removeItem(PENDING_KEY); } catch {}
    await cancelCheckout(held.orderId, held.clientSecret).catch(() => {});
  });

  // ---------- 3. payment ----------
  function teardownPayment() {
    elements = null;
    $('[data-payment-element]').innerHTML = '';
    show($('[data-pay]'), false);
    show($('[data-pay-fine]'), false);
    show($('[data-pay-hint]'), true);
    err('pay', null);
    $('[data-step="pay"]').setAttribute('data-locked', '');
  }

  function mountPayment(clientSecret: string) {
    const S = (window as any).Stripe;
    if (!S) { err('pay', 'Payment did not load. Reload the page to try again. Nothing was charged.'); return; }
    stripe ??= S(STRIPE_PK);
    elements = stripe.elements({
      clientSecret,
      appearance: {
        theme: 'stripe',
        variables: {
          colorPrimary: '#3A3A38', colorText: '#3A3A38', colorTextSecondary: '#8A8A87',
          colorBackground: '#ffffff', colorDanger: '#B3261E', borderRadius: '12px',
          fontFamily: 'Inter, system-ui, sans-serif', spacingUnit: '4px',
        },
        rules: { '.Input': { border: '1px solid #E4DED8', boxShadow: 'none' }, '.Tab': { border: '1px solid #E4DED8', boxShadow: 'none' } },
      },
    });
    const pe = elements.create('payment', {
      layout: { type: 'accordion', defaultCollapsed: false, radios: false, spacedAccordionItems: true },
      // No email prefill: a known email makes Stripe Link text the customer a
      // second code on top of ours. The email still goes on confirmPayment.
      fields: { billingDetails: { email: 'never' } },
      // No Stripe Link: its optional "Save my information" box asks for the
      // email and mobile the customer has just typed (T, 2026-10-21).
      wallets: { applePay: 'auto', googlePay: 'auto', link: 'never' },
    });
    pe.mount($('[data-payment-element]'));
    $('[data-step="pay"]').removeAttribute('data-locked');
    show($('[data-pay-hint]'), false);
    show($('[data-pay]'), true);
    show($('[data-pay-fine]'), true);
    pe.on('ready', () => $('[data-step="pay"]').scrollIntoView({ behavior: 'smooth', block: 'start' }));
  }

  async function doPay() {
    if (!stripe || !elements || !quote || confirming) return;
    err('pay', null);
    confirming = true;
    const b = $<HTMLButtonElement>('[data-pay]');
    b.disabled = true; b.textContent = 'Paying…';
    const ret = new URL(location.href);
    ret.searchParams.set('returned', '1');
    try {
      const res = await stripe.confirmPayment({
        elements,
        confirmParams: {
          return_url: ret.toString(),
          payment_method_data: { billing_details: { email: buyerEmail() ?? undefined } },
        },
        redirect: 'if_required',
      });
      if (res.error) {
        confirming = false;
        b.disabled = false; renderTotals();
        // Card errors from Stripe are written for customers ("Your card was declined.").
        err('pay', res.error.type === 'card_error' || res.error.type === 'validation_error'
          ? res.error.message
          : 'The payment did not go through. Nothing was charged. Please try again.');
        track('Store Web Payment Failed', { code: res.error.code ?? '', decline: res.error.decline_code ?? '' });
        return;
      }
      const status = res.paymentIntent?.status;
      if (status === 'succeeded' || status === 'processing') {
        finish();
        return;
      }
      confirming = false;
      b.disabled = false; renderTotals();
      err('pay', 'The payment was not completed. Nothing was charged. Please try again.');
    } catch {
      confirming = false;
      b.disabled = false; renderTotals();
      err('pay', 'Something went wrong confirming the payment. Check your bank app before trying again.');
    }
  }
  $('[data-pay]').addEventListener('click', doPay);

  function finish(pending?: any) {
    paid = true;
    const q = pending ?? quote;
    const f = pending?.fulfilment ?? fulfilment();
    const pickup = pending?.pickupId ?? pickupId;
    const storeName = root.querySelector<HTMLInputElement>(`input[name=pickup][value="${pickup}"]`)?.nextElementSibling?.textContent;
    try { sessionStorage.removeItem(PENDING_KEY); localStorage.removeItem(FORM_KEY); } catch {}
    show($('[data-main]'), false);
    show($('[data-confirm]'), true);
    $('[data-c-code]').textContent = q.orderCode;
    show($('[data-c-code]').parentElement, !!q.orderCode);
    const img = $<HTMLImageElement>('[data-c-img]');
    if (colour?.image) img.src = colour.image; else img.remove();
    $('[data-c-name]').textContent = product.name;
    $('[data-c-variant]').textContent = [product.colours.length > 1 ? colour!.name : null, `Size ${size}`].filter(Boolean).join(' · ');
    $('[data-c-total]').textContent = money(q.totalPence);
    const d = dispatchDate(product.expectedDispatchAt);
    $('[data-c-next]').textContent = f === 'delivery'
      ? (product.preorder && d ? `We will post it from HQ by ${d}.` : 'We will pack it at HQ and post it to your address.')
      : `We will text you when it is ready to collect${storeName ? ` from ${storeName}` : ''}.${product.preorder && d ? ` Expected by ${d}.` : ''}`;
    $('[data-c-email]').textContent = pending?.email ?? buyerEmail() ?? 'your email';
    window.scrollTo(0, 0);
    track('Store Web Purchased', { product: product.slug, total: q.totalPence, fulfilment: f });
  }

  // Leaving with a reservation releases it straight away (the server sweeps
  // anything missed after 20 minutes). Never during confirmPayment: a bank
  // redirect also unloads the page, and that intent must stay alive.
  window.addEventListener('pagehide', () => {
    if (quote && !confirming && !paid) cancelCheckout(quote.orderId, quote.clientSecret, true).catch(() => {});
  });

  async function boot() {
    loadSession();
    if (currentEmail()) await freshToken();
    renderAuth();

    const saved = restoreForm();
    fields.forEach((id) => { if (saved[id]) (document.getElementById(id) as HTMLInputElement).value = saved[id]; });
    if (saved.fulfilment === 'delivery') root.querySelector<HTMLInputElement>('input[name=fulfilment][value=delivery]')!.checked = true;
    pickupId = saved.store || null;
    renderFulfilment();

    const stores = await pickupStores();
    if (pickupId && !stores.some((s) => s.id === pickupId)) pickupId = null;
    if (!pickupId && stores.length === 1) pickupId = stores[0].id;
    renderStores(stores);

    // Back from a bank redirect (3-D Secure or similar). A banking app can
    // reopen the link in a fresh tab without our saved checkout, so trust the
    // PaymentIntent itself: if Stripe says it succeeded, it did.
    const returnedSecret = params.get('payment_intent_client_secret');
    if (params.get('returned') === '1' && returnedSecret) {
      let pending: any = null;
      try { pending = JSON.parse(sessionStorage.getItem(PENDING_KEY) || 'null'); } catch {}
      const S = (window as any).Stripe;
      if (S) {
        stripe ??= S(STRIPE_PK);
        const { paymentIntent } = await stripe.retrievePaymentIntent(returnedSecret);
        if (paymentIntent && (paymentIntent.status === 'succeeded' || paymentIntent.status === 'processing')) {
          finish(pending ?? { orderCode: '', totalPence: paymentIntent.amount, fulfilment: fulfilment(), pickupId, email: buyerEmail() });
          return;
        }
        if (pending) {
          quote = pending;
          lockDetails(true);
          mountPayment(pending.clientSecret);
        }
        err(pending ? 'pay' : 'reserve', 'The payment was not completed. Nothing was charged. Please try again.');
      }
    }
  }
</script>

