---
import Layout from '../../layouts/Layout.astro';
import StoreGallery from '../../components/StoreGallery.astro';
import StoreRail from '../../components/StoreRail.astro';
import StorePerks from '../../components/StorePerks.astro';
import StoreScripts from '../../components/StoreScripts.astro';
import store from '../../data/store.json';
import '../../styles/store.css';

export function getStaticPaths() {
  return store.products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product: p } = Astro.props;
const all = store.products;
const def = p.colours.find((c) => c.name === p.defaultColour) ?? p.colours[0];
const lead = def?.gallery[0] ?? p.colours.flatMap((c) => c.gallery)[0];
const url = `https://theacaiclub.com/store/${p.slug}/`;
const dispatch = p.expectedDispatchAt
  ? new Date(p.expectedDispatchAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'Europe/London' })
  : null;
const blurb = p.descriptionLines.length ? p.descriptionLines.join('. ') : 'From The Açai Club Store';
const description = `${p.price}. ${blurb}. Free collection or UK delivery.`.replace(/\.\./g, '.');
const subLine = [p.fit, p.colours.length > 1 ? `${p.colours.length} colours` : p.colours[0]?.name].filter(Boolean).join(' · ');
const isTee = p.categorySlug === 'clothing';

// "More in <category>": the rest of this category, in catalogue order.
const more = all.filter((x) => x.categoryId === p.categoryId && x.slug !== p.slug);
// "Complete the look": the other category (tee -> totes, tote -> tees).
// Deliberately not "customers also bought": there is not enough order history
// to say that truthfully.
const pair = all.filter((x) => x.categoryId !== p.categoryId).slice(0, 4);

// Google merchant listing structured data: one ProductGroup, a Product per
// colour x size with its own stock, plus delivery and returns so Google can
// show "£4.99 delivery" and "14-day returns". Facts match the backend
// (_shared/merch.ts) and the app checkout copy; customer pays return postage
// (T, 2026-10-21). Returns are stated for T-shirts only, as in the app.
const abs = (src: string) => new URL(src, 'https://theacaiclub.com').href;
const uniq = (xs: string[]) => [...new Set(xs)];
const shippingDetails = [
  {
    '@type': 'OfferShippingDetails',
    shippingRate: { '@type': 'MonetaryAmount', value: '4.99', currency: 'GBP' },
    shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'GB' },
  },
];
const returnPolicy = isTee
  ? {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'GB',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 14,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
    }
  : null;
// Only a colour's own photos: a Black variant must not carry the White
// stand-in shots (shownIn). Variants without photos inherit the group image.
const galleryFor = (c: (typeof p.colours)[number]) => (c.shownIn ? [] : uniq(c.gallery.map((g) => abs(g.src))));
const oneSize = p.colours.every((c) => c.sizes.length <= 1);
const variants = p.colours.flatMap((c) =>
  c.sizes.map((s) => ({
    '@type': 'Product',
    sku: s.variantId,
    name: oneSize ? `${p.name}` : `${p.name} – ${c.name}, ${s.size}`,
    ...(galleryFor(c).length ? { image: galleryFor(c) } : {}),
    color: c.name,
    ...(oneSize ? {} : { size: s.size }),
    offers: {
      '@type': 'Offer',
      url,
      priceCurrency: 'GBP',
      price: (p.pricePence / 100).toFixed(2),
      itemCondition: 'https://schema.org/NewCondition',
      availability: s.soldOut || p.soldOut
        ? 'https://schema.org/OutOfStock'
        : p.preorder ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock',
      shippingDetails,
      ...(returnPolicy ? { hasMerchantReturnPolicy: returnPolicy } : {}),
    },
  })),
);
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: p.name,
  url,
  productGroupID: p.slug,
  image: uniq(p.colours.flatMap((c) => c.gallery).map((g) => abs(g.src))),
  description: blurb,
  ...(p.materials ? { material: p.materials } : {}),
  brand: { '@type': 'Brand', name: 'The Açai Club' },
  variesBy: oneSize ? ['https://schema.org/color'] : ['https://schema.org/size', 'https://schema.org/color'],
  hasVariant: variants,
};
---

<Layout title={`${p.name} | The Açai Club Store`} description={description} ogImage={lead?.src} ogImageWidth={lead?.width} ogImageHeight={lead?.height} schemaJsonLd={productSchema} crumbName={p.name}>
  <div class="store min-h-screen">
    <div class="max-w-[1200px] mx-auto md:px-6 md:pt-6">
      <nav class="store-crumbs hidden md:block mb-4" aria-label="Breadcrumb">
        <a href="/store">Store</a>
        {p.categoryName && <> / <a href="/store#shop">{p.categoryName}</a></>}
        {' / '}<span style="color:var(--s-ink)">{p.name}</span>
      </nav>

      <div class="md:grid md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:gap-12">
        <!-- Gallery -->
        <div>
          <div class="relative aspect-[4/5] md:rounded-[14px] overflow-hidden" style="background:var(--s-placeholder)" id="main-gallery">
            {p.colours.map((c) => (
              <StoreGallery images={c.gallery} colour={c.name} active={c.name === def?.name} eager sizes="(min-width:768px) 55vw, 100vw" note={c.shownIn ? `Shown in ${c.shownIn}` : ''} />
            ))}
            {p.soldOut && <div class="store-soldout">Sold out</div>}
            {p.preorder && !p.soldOut && <span class="store-badge">Pre-order</span>}
          </div>
          {p.colours.map((c) => c.gallery.length > 1 && (
            <div class="store-thumbs" data-thumbs={c.name} hidden={c.name !== def?.name}>
              {c.gallery.map((g, i) => (
                <button type="button" data-index={i} aria-label={`Photo ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}>
                  <img src={g.src} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          ))}
        </div>

        <!-- Details -->
        <div class="px-5 pt-5 pb-6 md:px-0 md:pt-2">
          <div class="md:sticky md:top-[84px]">
            {p.categoryName && <p class="store-eyebrow">{p.categoryName}</p>}
            <h1 class="mt-1.5 text-[24px] md:text-[30px] font-bold leading-[1.15]">{p.name}</h1>
            {subLine && <p class="store-sub mt-1.5">{subLine}</p>}
            <p class="mt-3 text-[20px] font-bold">{p.price}</p>

            {p.preorder && (
              <p class="mt-3 text-[13px] font-semibold" style="color:var(--s-muted)">
                Pre-order. {dispatch ? `Expected to dispatch by ${dispatch}.` : 'Dispatch date to be confirmed.'}
              </p>
            )}

            {p.colours.length > 1 && (
              <>
                <p class="store-field mt-6">Colour: <span style="color:var(--s-ink)" data-colour-name>{def?.name}</span></p>
                <div class="mt-2.5 flex flex-wrap gap-2.5">
                  {p.colours.map((c) => (
                    <button type="button" class="store-pill-colour" data-colour={c.name} aria-pressed={c.name === def?.name ? 'true' : 'false'}>
                      <span style={`background:${c.swatch}`}></span>{c.name}
                    </button>
                  ))}
                </div>
              </>
            )}

            <div class="mt-6 flex items-baseline justify-between">
              <p class="store-field" id="size-label">Size</p>
              <p class="text-[12px] font-semibold" style="color:var(--s-muted)" data-size-picked></p>
            </div>
            {p.colours.map((c) => (
              <div class="mt-2.5 flex flex-wrap gap-2.5" role="radiogroup" aria-labelledby="size-label" data-sizes={c.name} hidden={c.name !== def?.name}>
                {c.sizes.map((s) => (
                  <button type="button" role="radio" aria-checked="false" class="store-size-pick" data-variant={s.variantId} data-size={s.size} disabled={s.soldOut} data-soldout={s.soldOut ? '' : undefined}>
                    <b>{s.size}</b>{s.soldOut && <small>Sold out</small>}
                  </button>
                ))}
              </div>
            ))}
            <p class="store-size-err mt-2" role="alert" data-size-err hidden>Choose a size to continue.</p>

            <div class="hidden md:flex items-center gap-3 mt-7">
              <a href={p.soldOut ? undefined : `/store/checkout/?product=${p.slug}`} aria-disabled={p.soldOut ? "true" : undefined} data-soldout-cta={p.soldOut ? "" : undefined} class="store-cta flex-1" data-buy data-buy-label>{p.soldOut ? 'Sold out' : p.preorder ? 'Pre-order' : 'Buy now'}</a>
              <button type="button" class="store-share" data-share data-url={url} data-title={p.name} aria-label="Share">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
                <span>Share</span>
              </button>
            </div>
            <div class="mt-5 md:hidden">
            <button type="button" class="store-share" data-share data-url={url} data-title={p.name}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
              <span>Share</span>
            </button>
            </div>

            <div class="mt-6"><StorePerks list /></div>

            <!-- Accordions -->
            <div class="mt-6">
              <details class="store-acc" open>
                <summary>Details</summary>
                <div class="store-acc-body">
                  {p.descriptionLines.length > 0 && (
                    <ul class="store-bullets">{p.descriptionLines.map((line) => <li>{line}</li>)}</ul>
                  )}
                </div>
              </details>
              {p.materials && (
                <details class="store-acc">
                  <summary>Materials &amp; Care</summary>
                  <div class="store-acc-body"><p>{p.materials}</p></div>
                </details>
              )}
              <details class="store-acc">
                <summary>Collection &amp; Delivery</summary>
                <div class="store-acc-body">
                  <p><b style="color:var(--s-ink)">Collect in store, free.</b> Choose Reading, Datchet or Beaconsfield at checkout. We text you when your order is ready.</p>
                  <p><b style="color:var(--s-ink)">Delivery, £4.99.</b> UK mainland. Add your address at checkout.</p>
                </div>
              </details>
              {isTee && (
                <details class="store-acc">
                  <summary>Returns</summary>
                  <div class="store-acc-body">
                    <p>Unused T-shirts may be returned within 14 days; return postage is paid by you. Email <a href="mailto:hello@theacaiclub.com" style="color:var(--s-ink);text-decoration:underline">hello@theacaiclub.com</a> with your order number.</p>
                  </div>
                </details>
              )}
              <details class="store-acc">
                <summary>How to buy</summary>
                <div class="store-acc-body">
                  <p>Pick your colour and size, tap Buy now, then choose collection or delivery and pay securely by card.</p>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>

      <div class="pb-16">
        <StoreRail title={isTee ? 'Complete the look' : 'Pair it with'} products={pair} href="/store#shop" />
        <StoreRail title={`More in ${p.categoryName ?? 'the Store'}`} products={more} href="/store#shop" />
      </div>
    </div>

    <div class="store-bar md:hidden">
      <div class="px-5 py-3 flex items-center gap-4" style="padding-bottom:max(12px, env(safe-area-inset-bottom))">
        <div class="flex-1 min-w-0">
          <p class="text-[17px] font-bold">{p.price}</p>
          <p class="text-[12px]" style="color:var(--s-muted)">Collect free or £4.99 delivery</p>
        </div>
        <a href={p.soldOut ? undefined : `/store/checkout/?product=${p.slug}`} aria-disabled={p.soldOut ? "true" : undefined} data-soldout-cta={p.soldOut ? "" : undefined} class="store-cta" data-buy data-buy-label>{p.soldOut ? 'Sold out' : p.preorder ? 'Pre-order' : 'Buy now'}</a>
      </div>
    </div>
  </div>
  <StoreScripts />
</Layout>

<script>
  // Colour pills swap the gallery, thumbnails and size row. ?colour= (set by
  // a Store card's dots) opens on that colour.
  const pills = document.querySelectorAll<HTMLButtonElement>('.store-pill-colour');
  const main = document.getElementById('main-gallery')!;
  function select(colour: string) {
    if (![...pills].some((p) => p.dataset.colour === colour)) return;
    pills.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.colour === colour)));
    main.querySelectorAll<HTMLElement>('.store-photo-wrap').forEach((w) => { w.hidden = w.dataset.colour !== colour; });
    document.querySelectorAll<HTMLElement>('[data-sizes]').forEach((s) => { s.hidden = s.dataset.sizes !== colour; });
    document.querySelectorAll<HTMLElement>('[data-thumbs]').forEach((t) => { t.hidden = t.dataset.thumbs !== colour; });
    const name = document.querySelector('[data-colour-name]');
    if (name) name.textContent = colour;
  }
  pills.forEach((p) => p.addEventListener('click', () => {
    select(p.dataset.colour!);
    const u = new URL(location.href);
    u.searchParams.set('colour', p.dataset.colour!);
    history.replaceState(null, '', u);
  }));
  const wanted = new URLSearchParams(location.search).get('colour');
  if (wanted) select(wanted);

  // Size choice drives the Buy links. Nothing is pre-chosen when there is a
  // real choice (a silent default sends people the wrong size); a single
  // in-stock size is chosen for them.
  const buyLinks = document.querySelectorAll<HTMLAnchorElement>('[data-buy-label]');
  const productSlug = location.pathname.split('/').filter(Boolean)[1] ?? '';
  let picked: HTMLButtonElement | null = null;
  function currentRow() {
    return [...document.querySelectorAll<HTMLElement>('[data-sizes]')].find((r) => !r.hidden) ?? null;
  }
  function setPicked(btn: HTMLButtonElement | null) {
    picked = btn;
    document.querySelectorAll<HTMLButtonElement>('.store-size-pick').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
    const label = document.querySelector('[data-size-picked]');
    if (label) label.textContent = btn ? `Size ${btn.dataset.size}` : '';
    if (btn) document.querySelector<HTMLElement>('[data-size-err]')!.hidden = true;
    buyLinks.forEach((a) => {
      a.href = btn ? `/store/checkout/?product=${productSlug}&variant=${btn.dataset.variant}` : `/store/checkout/?product=${productSlug}`;
    });
  }
  function autoPick() {
    const open = [...(currentRow()?.querySelectorAll<HTMLButtonElement>('.store-size-pick:not([disabled])') ?? [])];
    setPicked(open.length === 1 ? open[0] : null);
  }
  document.querySelectorAll<HTMLButtonElement>('.store-size-pick').forEach((b) => b.addEventListener('click', () => setPicked(b)));
  pills.forEach((p) => p.addEventListener('click', autoPick));
  autoPick();
  buyLinks.forEach((a) => a.addEventListener('click', (e) => {
    if (a.hasAttribute("data-soldout-cta")) { e.preventDefault(); return; }
    if (picked) return;
    e.preventDefault();
    const err = document.querySelector<HTMLElement>('[data-size-err]')!;
    err.hidden = false;
    document.getElementById('size-label')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }));

  // Desktop thumbnails drive the visible gallery.
  document.querySelectorAll<HTMLElement>('[data-thumbs]').forEach((strip) => {
    const gallery = main.querySelector<HTMLElement>(`.store-photo-wrap[data-colour="${CSS.escape(strip.dataset.thumbs!)}"] .store-gallery`);
    if (!gallery) return;
    const btns = strip.querySelectorAll<HTMLButtonElement>('button');
    btns.forEach((b) => b.addEventListener('click', () => {
      gallery.scrollTo({ left: Number(b.dataset.index) * gallery.clientWidth, behavior: 'smooth' });
    }));
    gallery.addEventListener('scroll', () => {
      const p = Math.round(gallery.scrollLeft / Math.max(gallery.clientWidth, 1));
      btns.forEach((b, i) => b.setAttribute('aria-current', String(i === p)));
    }, { passive: true });
  });

  // Native share sheet where there is one, otherwise copy the link.
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((share) => {
    share.addEventListener('click', async () => {
      const url = share.dataset.url!;
      const title = share.dataset.title!;
      const label = share.querySelector('span')!;
      try {
        if (navigator.share) {
          await navigator.share({ title, text: `${title} from The Açai Club`, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        label.textContent = 'Link copied';
        setTimeout(() => { label.textContent = 'Share'; }, 2000);
      } catch { /* dismissed */ }
    });
  });
</script>
