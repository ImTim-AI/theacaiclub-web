---
import Layout from '../layouts/Layout.astro';

const appSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    '@id': 'https://theacaiclub.com/app/#ios',
    name: 'The Açai Club',
    operatingSystem: 'iOS',
    applicationCategory: 'FoodApplication',
    description: 'Order ahead and earn 10 points per £1 paid by card, plus 100 points per Run Club run. Get 100 points on signup.',
    downloadUrl: 'https://apps.apple.com/gb/app/the-a%C3%A7ai-club/id6478923734',
    installUrl: 'https://apps.apple.com/gb/app/the-a%C3%A7ai-club/id6478923734',
    publisher: { '@id': 'https://theacaiclub.com/#organization' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    '@id': 'https://theacaiclub.com/app/#android',
    name: 'The Açai Club',
    operatingSystem: 'Android',
    applicationCategory: 'FoodApplication',
    description: 'Order ahead and earn 10 points per £1 paid by card, plus 100 points per Run Club run. Get 100 points on signup.',
    downloadUrl: 'https://play.google.com/store/apps/details?id=com.epostechnologies.theacaiclub',
    installUrl: 'https://play.google.com/store/apps/details?id=com.epostechnologies.theacaiclub',
    publisher: { '@id': 'https://theacaiclub.com/#organization' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  },
];
---

<Layout title="Download the App | The Açai Club" description="Download The Açai Club app for iOS or Android. Earn 10 points per £1 paid by card and 100 per Run Club run. Get 100 points on signup." schemaJsonLd={appSchemas}>

  <!-- Hero - clean, centered like Joe Juice -->
  <section class="relative pt-32 pb-28 bg-dark overflow-hidden">
    <!-- Large faded background text -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
      <span class="font-heading font-medium text-[18vw] uppercase leading-none text-light/[0.08] whitespace-nowrap">
        REWARDS
      </span>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-8 text-center">
      <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-black uppercase tracking-tight text-light leading-tight">
        Earn points, skip the line, <span class="text-charcoal">claim rewards</span>
      </h1>
      <p class="mt-6 text-grey text-lg max-w-lg mx-auto leading-relaxed">
        Download the app & earn points with every order. Get 100 points on signup.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://apps.apple.com/gb/app/the-a%C3%A7ai-club/id6478923734" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-taupe text-white rounded-full hover:bg-taupe-dark transition-colors">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div class="text-left">
            <div class="text-[10px] leading-none opacity-60">Download on the</div>
            <div class="text-sm font-heading font-normal leading-tight">App Store</div>
          </div>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.epostechnologies.theacaiclub" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-taupe text-white rounded-full hover:bg-taupe-dark transition-colors">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.67L14.09 12.77 3.18.33a.42.42 0 00-.18.35v22.65c0 .15.07.27.18.34zm.77.33l12.37-7.14-2.73-2.73zm12.37-16.53L3.95 0l10.64 10.64zm4.14 3.53l-3.31-1.91-2.97 2.97 2.97 2.97 3.31-1.91a1.07 1.07 0 000-2.12z"/></svg>
          <div class="text-left">
            <div class="text-[10px] leading-none opacity-60">Get it on</div>
            <div class="text-sm font-heading font-normal leading-tight">Google Play</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Points earning and reward ladder (app design language: PointsMark disc, Order-page product cards) -->
  <section class="py-24 bg-dark-surface">
    <div class="max-w-[1400px] mx-auto px-6 sm:px-8">
      <div class="flex flex-col items-center text-center mb-12">
        <span class="points-mark w-14 h-14 mb-5" aria-hidden="true"><img src="/images/points-mark.png" alt="" /></span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-light">
          Earn points, <span class="text-charcoal">choose rewards</span>
        </h2>
        <p class="text-grey mt-3 max-w-xl">Collect points in the app and swap them for your favourites.</p>
      </div>

      <div class="max-w-4xl mx-auto">
        <h3 class="font-heading text-lg font-bold text-light mb-4">How you earn</h3>
        <div class="grid sm:grid-cols-3 gap-4 mb-12">
          <div class="bg-dark-card rounded-[15px] border border-dark-border p-5 flex items-center gap-4">
            <span class="points-mark w-11 h-11 shrink-0" aria-hidden="true"><img src="/images/points-mark.png" alt="" /></span>
            <div><p class="font-heading text-2xl font-bold text-light leading-none">100 pts</p><p class="text-grey text-sm mt-1">when you sign up</p></div>
          </div>
          <div class="bg-dark-card rounded-[15px] border border-dark-border p-5 flex items-center gap-4">
            <span class="points-mark w-11 h-11 shrink-0" aria-hidden="true"><img src="/images/points-mark.png" alt="" /></span>
            <div><p class="font-heading text-2xl font-bold text-light leading-none">10 pts</p><p class="text-grey text-sm mt-1">per £1 paid by card</p></div>
          </div>
          <div class="bg-dark-card rounded-[15px] border border-dark-border p-5 flex items-center gap-4">
            <span class="points-mark w-11 h-11 shrink-0" aria-hidden="true"><img src="/images/points-mark.png" alt="" /></span>
            <div><p class="font-heading text-2xl font-bold text-light leading-none">100 pts</p><p class="text-grey text-sm mt-1">per Run Club run</p></div>
          </div>
        </div>

        <div class="flex items-baseline justify-between gap-4 mb-4">
          <h3 class="font-heading text-lg font-bold text-light">Spend your points</h3>
          <p class="text-grey text-xs sm:text-sm">At checkout in the app · Datchet rewards shown</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="reward-card"><div class="reward-photo"><img src="/images/rewards/latte.jpg" alt="Latte" loading="lazy" /></div><p class="font-heading font-bold text-light mt-3">Coffee</p><span class="reward-pill">300 pts</span></div>
          <div class="reward-card"><div class="reward-photo"><img src="/images/rewards/matcha.jpg" alt="Iced Matcha Latte" loading="lazy" /></div><p class="font-heading font-bold text-light mt-3">Matcha</p><span class="reward-pill">450 pts</span></div>
          <div class="reward-card"><div class="reward-photo"><img src="/images/rewards/smoothie.jpg" alt="Green Goddess smoothie" loading="lazy" /></div><p class="font-heading font-bold text-light mt-3">Smoothie</p><span class="reward-pill">600 pts</span></div>
          <div class="reward-card"><div class="reward-photo"><img src="/images/rewards/bowl.jpg" alt="The OG açai bowl" loading="lazy" /></div><p class="font-heading font-bold text-light mt-3">Açai Bowl</p><span class="reward-pill">900 pts</span></div>
        </div>
        <p class="text-grey text-xs mt-4 text-center">Rewards are set by each store. Points cover the item itself; paid extras are charged as usual.</p>
      </div>
    </div>
  </section>

  <style>
    /* PointsMark: dark taupe disc, light taupe brand mark at 40% (same as the app) */
    .points-mark { display:inline-flex; align-items:center; justify-content:center; border-radius:9999px; background:#A3998E; }
    .points-mark img { width:40%; height:40%; object-fit:contain; }
    /* Order-page product card: white, grey border, radius 15, 10 padding, photo box radius 10 */
    .reward-card { background:#fff; border:1px solid #E0E0E0; border-radius:15px; padding:10px 10px 14px; text-align:center; }
    .reward-photo { aspect-ratio:1/1; background:#EDE8E4; border-radius:10px; overflow:hidden; }
    .reward-photo img { width:100%; height:100%; object-fit:contain; }
    .reward-pill { display:inline-block; margin-top:6px; padding:3px 10px; border-radius:9999px; background:#EDE5DE; color:#3A3A38; font-size:12px; font-weight:600; }
  </style>

  <!-- How it works -->
  <section class="py-24 bg-dark">
    <div class="max-w-[1400px] mx-auto px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold uppercase tracking-tight text-light text-center mb-16">
        How it works
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-dark-card border border-dark-border flex items-center justify-center font-heading font-normal text-xl text-charcoal mx-auto mb-5">1</div>
          <h3 class="font-heading font-normal text-light mb-2">Download</h3>
          <p class="text-grey text-sm">Get the app & create your free account in seconds. Get 100 points on signup.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-dark-card border border-dark-border flex items-center justify-center font-heading font-normal text-xl text-charcoal mx-auto mb-5">2</div>
          <h3 class="font-heading font-normal text-light mb-2">Order</h3>
          <p class="text-grey text-sm">Order in-store or ahead through the app.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-dark-card border border-dark-border flex items-center justify-center font-heading font-normal text-xl text-charcoal mx-auto mb-5">3</div>
          <h3 class="font-heading font-normal text-light mb-2">Earn</h3>
          <p class="text-grey text-sm">Earn 10 points per £1 paid by card and 100 per Run Club run.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-dark-card border border-dark-border flex items-center justify-center font-heading font-normal text-xl text-charcoal mx-auto mb-5">4</div>
          <h3 class="font-heading font-normal text-light mb-2">Redeem</h3>
          <p class="text-grey text-sm">Spend your points on drinks &amp; bowls at checkout.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-24 bg-dark-surface border-t border-dark-border">
    <div class="max-w-4xl mx-auto px-8 text-center">
      <h2 class="font-heading text-4xl sm:text-5xl font-bold uppercase tracking-tight text-light mb-4">
        Your first 100 points <span class="text-charcoal">on us</span>
      </h2>
      <p class="text-grey text-lg mb-10">
        Download the app, sign up & claim your 100 signup points.
      </p>
      <a id="download-now" href="https://apps.apple.com/gb/app/the-a%C3%A7ai-club/id6478923734" target="_blank" rel="noopener noreferrer" class="inline-flex px-10 py-4 bg-taupe text-white font-heading font-bold uppercase tracking-wider text-sm rounded-full hover:bg-taupe-dark transition-colors">
        Download Now
      </a>
    </div>
  </section>

  <script is:inline>
    (function () {
      const link = document.getElementById('download-now');
      if (!link) return;
      const ua = navigator.userAgent || '';
      if (/android/i.test(ua)) {
        link.href = 'https://play.google.com/store/apps/details?id=com.epostechnologies.theacaiclub';
      }
    })();
  </script>

</Layout>
