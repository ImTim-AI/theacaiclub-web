---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schemaJsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = "Fresh açai bowls, smoothies & good vibes. Three UK stores in Reading, Beaconsfield & Datchet. Join our Sunday Run Club & earn rewards in the app.",
  ogImage = '/images/logo.jpg',
  ogType = 'website',
  schemaJsonLd,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const absoluteOgImage = new URL(ogImage, Astro.site).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': 'https://theacaiclub.com/#organization',
  name: 'The Açai Club',
  alternateName: 'The Acai Club',
  url: 'https://theacaiclub.com',
  logo: 'https://theacaiclub.com/icon-512.png',
  image: 'https://theacaiclub.com/icon-512.png',
  description: 'UK açai bowl restaurant chain with three stores in Reading, Beaconsfield, and Datchet. Never blended pure açai, real ingredients, Sunday Run Club, and a rewards app.',
  servesCuisine: ['Açaí', 'Smoothies', 'Healthy', 'Breakfast'],
  priceRange: '££',
  legalName: 'THE ACAI CLUB LTD',
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'CompaniesHouse',
    value: '15227787',
  },
  email: 'hello@theacaiclub.com',
  sameAs: [
    'https://www.instagram.com/theacaiclub_/',
    'https://www.tiktok.com/@theacaiclub_',
    'https://www.facebook.com/p/The-A%C3%A7ai-Club-61552735080430/',
    'https://apps.apple.com/gb/app/the-a%C3%A7ai-club/id6478923734',
    'https://play.google.com/store/apps/details?id=com.epostechnologies.theacaiclub',
    'https://find-and-update.company-information.service.gov.uk/company/15227787',
  ],
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'GB',
    addressRegion: 'England',
  },
  acceptsReservations: false,
};

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbSchema = pathSegments.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://theacaiclub.com/' },
        ...pathSegments.map((seg, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
          item: `https://theacaiclub.com/${pathSegments.slice(0, i + 1).join('/')}/`,
        })),
      ],
    }
  : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://theacaiclub.com/#website',
  url: 'https://theacaiclub.com',
  name: 'The Açai Club',
  publisher: { '@id': 'https://theacaiclub.com/#organization' },
  inLanguage: 'en-GB',
};

const baseSchemas = breadcrumbSchema
  ? [organizationSchema, websiteSchema, breadcrumbSchema]
  : [organizationSchema, websiteSchema];
const allSchemas = schemaJsonLd
  ? [...baseSchemas, ...(Array.isArray(schemaJsonLd) ? schemaJsonLd : [schemaJsonLd])]
  : baseSchemas;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Apple Smart App Banner (native iOS Safari banner). Excluded on /order so it
        doesn't pull a customer out of a web order mid-checkout. */}
    {!Astro.url.pathname.startsWith('/order') && <meta name="apple-itunes-app" content="app-id=6478923734" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="The Açai Club" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#DED9D4" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.cdnfonts.com/css/gotham" rel="stylesheet" />

    <title>{title}</title>

    <!-- Structured data -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Mixpanel: site-wide product analytics (same project as the app, so the
         landing -> menu -> order funnel is one view). Client token (also shipped
         in the app binary). -->
    <script is:inline>
      (function(f,b){if(!b.__SV){var e,g,i,h;window.mixpanel=b;b._i=[];b.init=function(e,f,c){function g(a,d){var b=d.split(".");2==b.length&&(a=a[b[0]],d=b[1]);a[d]=function(){a.push([d].concat(Array.prototype.slice.call(arguments,0)))}}var a=b;"undefined"!==typeof c?a=b[c]=[]:c="mixpanel";a.people=a.people||[];a.toString=function(a){var d="mixpanel";"mixpanel"!==c&&(d+="."+c);a||(d+=" (stub)");return d};a.people.toString=function(){return a.toString(1)+".people (stub)"};i="disable time_event track track_pageview track_links track_forms track_with_groups add_group set_group remove_group register register_once alias unregister identify name_tag set_config reset opt_in_tracking opt_out_tracking has_opted_in_tracking has_opted_out_tracking clear_opt_in_out_tracking start_batch_senders people.set people.set_once people.unset people.increment people.append people.union people.track_charge people.clear_charges people.delete_user people.remove".split(" ");for(h=0;h<i.length;h++)g(a,i[h]);var j="set set_once union unset remove delete".split(" ");a.get_group=function(){function b(c){d[c]=function(){call2_args=arguments;call2=[c].concat(Array.prototype.slice.call(call2_args,0));a.push([e,call2])}}for(var d={},e=["get_group"].concat(Array.prototype.slice.call(arguments,0)),c=0;c<j.length;c++)b(j[c]);return d};b._i.push([e,f,c])};b.__SV=1.2;e=f.createElement("script");e.type="text/javascript";e.async=!0;e.src="https://cdn.mxpnl.com/libs/mixpanel-2-latest.min.js";g=f.getElementsByTagName("script")[0];g.parentNode.insertBefore(e,g)}})(document,window.mixpanel||[]);
      try{mixpanel.init('1718606a902f1bdb3226ed1c4cb60a2f',{persistence:'localStorage',opt_out_tracking_by_default:true});}catch(e){}
    </script>
  </head>
  <body class="antialiased bg-dark">
    <Navbar />
    <main class="pt-[60px]">
      <slot />
    </main>
    <Footer />

    <!-- Android app-install banner. iOS uses the native Apple Smart App Banner;
         Android has no OS equivalent, so this small dismissible bar covers it.
         Shown only on Android, never on /order, and only after cookie choice so
         it doesn't stack on the consent banner. -->
    <div id="appBanner" style="display:none;position:fixed;left:12px;right:12px;bottom:12px;z-index:9998;background:#fff;color:#1a1a1a;border-radius:14px;padding:10px 12px;box-shadow:0 10px 34px rgba(0,0,0,.25);font-family:Inter,system-ui,sans-serif;align-items:center;gap:12px;max-width:560px;margin:0 auto">
      <img src="/images/logo.jpg" alt="The Açai Club" width="40" height="40" style="width:40px;height:40px;border-radius:10px;flex:none;object-fit:cover" />
      <div style="flex:1;min-width:0;line-height:1.3">
        <div style="font-weight:800;font-size:14px">The Açai Club</div>
        <div style="font-size:12px;color:#666">Order ahead and earn rewards</div>
      </div>
      <a href="https://play.google.com/store/apps/details?id=com.epostechnologies.theacaiclub" id="appGet" style="background:#1a1a1a;color:#fff;border-radius:999px;padding:9px 16px;font-weight:700;font-size:13px;text-decoration:none;white-space:nowrap;flex:none">Get app</a>
      <button id="appClose" type="button" aria-label="Dismiss" style="background:transparent;border:none;color:#999;font-size:18px;line-height:1;cursor:pointer;flex:none;padding:4px">✕</button>
    </div>
    <script is:inline>
      (function(){
        var KEY='acai_app_banner_dismissed';
        function show(){
          var b=document.getElementById('appBanner'); if(!b)return;
          var dismissed=false; try{dismissed=localStorage.getItem(KEY)==='1';}catch(e){}
          var isAndroid=/Android/i.test(navigator.userAgent||'');
          var consent=true; try{consent=!!localStorage.getItem('acai_cookie_consent');}catch(e){}
          var onOrder=/^\/order/.test(location.pathname);
          if(isAndroid && !dismissed && consent && !onOrder){ b.style.display='flex'; }
        }
        window.acaiShowAppBanner=show;
        document.addEventListener('DOMContentLoaded',function(){
          var c=document.getElementById('appClose');
          if(c)c.onclick=function(){try{localStorage.setItem(KEY,'1');}catch(e){} var b=document.getElementById('appBanner'); if(b)b.style.display='none';};
          show();
        });
      })();
    </script>

    <!-- Cookie consent: granular (Accept / Only required / Show details with
         per-category toggles). We only set two kinds of cookies, so we list
         exactly those. Analytics stays opted-out until accepted. The footer
         "Cookie settings" link re-opens this. -->
    <div id="ckBanner" style="display:none;position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;background:#1a1a1a;color:#fff;border-radius:14px;padding:18px;box-shadow:0 12px 40px rgba(0,0,0,.4);font-family:Inter,system-ui,sans-serif;font-size:13px;line-height:1.55;max-width:560px;margin:0 auto">
      <div style="font-weight:700;font-size:15px;margin-bottom:6px">Cookies on The Açai Club</div>
      <div>We use cookies to run the site and make ordering work. With your OK we also use analytics cookies to see how the site is used and improve it. See our <a href="/privacy" style="color:#E8B4B8;text-decoration:underline">Privacy Policy</a>.</div>
      <div id="ckDetails" style="display:none;margin-top:14px;border-top:1px solid #333;padding-top:8px">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #2a2a2a">
          <span><b>Strictly necessary</b><br><span style="color:#aaa">Keeps the site, your basket and checkout working.</span></span>
          <span style="color:#aaa;font-size:12px;white-space:nowrap;padding-top:2px">Always on</span>
        </div>
        <label style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:9px 0;cursor:pointer">
          <span><b>Analytics</b><br><span style="color:#aaa">Helps us understand how the site is used so we can improve it.</span></span>
          <input type="checkbox" id="ckAnalytics" style="width:22px;height:22px;flex:none;accent-color:#9B9B90;margin-top:2px" />
        </label>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;justify-content:flex-end">
        <button id="ckOnlyReq" type="button" style="background:transparent;color:#fff;border:1px solid #555;border-radius:999px;padding:9px 16px;font-weight:700;font-size:13px;cursor:pointer">Only required</button>
        <button id="ckDetailsBtn" type="button" style="background:transparent;color:#fff;border:1px solid #555;border-radius:999px;padding:9px 16px;font-weight:700;font-size:13px;cursor:pointer">Show details</button>
        <button id="ckSave" type="button" style="display:none;background:#fff;color:#1a1a1a;border:none;border-radius:999px;padding:9px 18px;font-weight:700;font-size:13px;cursor:pointer">Save preferences</button>
        <button id="ckAccept" type="button" style="background:#fff;color:#1a1a1a;border:none;border-radius:999px;padding:9px 20px;font-weight:700;font-size:13px;cursor:pointer">Accept</button>
      </div>
    </div>
    <script is:inline>
      (function(){
        var KEY='acai_cookie_consent';
        function apply(v){try{if(!window.mixpanel)return;
          if(v==='accepted'){ mixpanel.opt_in_tracking&&mixpanel.opt_in_tracking(); mixpanel.track_pageview&&mixpanel.track_pageview(); }
          else { mixpanel.opt_out_tracking&&mixpanel.opt_out_tracking(); }
        }catch(e){}}
        function choose(v){try{localStorage.setItem(KEY,v);}catch(e){} apply(v); var b=document.getElementById('ckBanner'); if(b)b.style.display='none'; try{window.acaiShowAppBanner&&window.acaiShowAppBanner();}catch(e){}}
        function openBanner(){
          var c=null;try{c=localStorage.getItem(KEY);}catch(e){}
          var t=document.getElementById('ckAnalytics'); if(t)t.checked=(c==='accepted');
          var d=document.getElementById('ckDetails'), s=document.getElementById('ckSave'), db=document.getElementById('ckDetailsBtn');
          if(d)d.style.display='none'; if(s)s.style.display='none'; if(db)db.textContent='Show details';
          var b=document.getElementById('ckBanner'); if(b)b.style.display='';
        }
        window.acaiOpenCookieSettings=openBanner;
        document.addEventListener('DOMContentLoaded',function(){
          var c=null;try{c=localStorage.getItem(KEY);}catch(e){}
          var acc=document.getElementById('ckAccept'), req=document.getElementById('ckOnlyReq'),
              det=document.getElementById('ckDetailsBtn'), sav=document.getElementById('ckSave'),
              panel=document.getElementById('ckDetails'), tog=document.getElementById('ckAnalytics'),
              opener=document.getElementById('ckOpen');
          if(acc)acc.onclick=function(){choose('accepted');};
          if(req)req.onclick=function(){choose('declined');};
          if(det)det.onclick=function(){var open=panel&&panel.style.display!=='none'; if(panel)panel.style.display=open?'none':'block'; if(sav)sav.style.display=open?'none':''; det.textContent=open?'Show details':'Hide details';};
          if(sav)sav.onclick=function(){choose(tog&&tog.checked?'accepted':'declined');};
          if(opener)opener.addEventListener('click',function(e){e.preventDefault();openBanner();});
          if(c==='accepted')apply('accepted');
          else if(c==='declined')apply('declined');
          else openBanner();
        });
      })();
    </script>
  </body>
</html>
