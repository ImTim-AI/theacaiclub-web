---
// Facts the app's checkout actually enforces (merch_checkout_page.dart,
// _shared/merch.ts): free collection, £4.99 delivery, card payment on the
// web (card only, T 2026-10-21), 14-day returns on unused T-shirts.
interface Props { list?: boolean }
const { list = false } = Astro.props;
const perks = [
  { icon: 'store', title: 'Free collection', text: 'Reading, Datchet or Beaconsfield' },
  { icon: 'truck', title: 'UK delivery £4.99', text: 'Or collect in store for free' },
  { icon: 'card', title: 'Secure checkout', text: 'Card, Apple Pay or Google Pay' },
];
---
<ul class:list={['store-perks', list && 'store-perks-list']}>
  {perks.map((p) => (
    <li>
      <span class="store-perk-icon" aria-hidden="true">
        {p.icon === 'store' && <svg viewBox="0 0 24 24"><path d="M3 9l1.5-5h15L21 9M3 9h18M3 9v1a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0V9M5 13v7h14v-7M10 20v-4h4v4"/></svg>}
        {p.icon === 'truck' && <svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7M7.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM17.5 19a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/></svg>}
        {p.icon === 'card' && <svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 10h18M7 15h4"/></svg>}
      </span>
      <span><b>{p.title}</b><small>{p.text}</small></span>
    </li>
  ))}
</ul>
